package ddto.ui.mainmenu;

import funkin.modding.module.Module;
import funkin.ui.mainmenu.MainMenuState;
import funkin.ui.AtlasMenuItem;

class CostumeButtonDoki extends Module
{
  public function new()
  {
    super('CostumeButtonDoki', 1, {state: MainMenuState});
  }

  var rememberedSelectedIndex:Null<Int>;

  public function onStateChangeEnd(event:StateChangeScriptEvent):Void
  {
    var menuItem = createMenuItem('costumes', 'ui/main-menu/items/costumes-menu', 2, function()
    {
      FlxG.state.startExitState(() -> new CostumeSelectState());
    }, false);
    FlxG.state.menuItems.addItem('costumes', menuItem);

    // Kidnap the menu item so we can put it in the right spot.
    var item:AtlasMenuItem = FlxG.state.menuItems.getItem('costumes');
    FlxG.state.menuItems.members.remove(item);
    FlxG.state.menuItems.members.insert(item.ID, item);
    repositionMenuItems(FlxG.state.menuItems);

    var setIndex:Int = rememberedSelectedIndex ?? MainMenuState.rememberedSelectedIndex;
    if (FlxG.state.menuItems.members[setIndex] != null)
    {
      FlxG.state.menuItems.selectItem(setIndex);
    }
    rememberedSelectedIndex = null;

    FlxG.signals.preStateSwitch.addOnce(() ->
    {
      // Use our own variable to set the selected item to prevent a crash
      rememberedSelectedIndex = FlxG.state.menuItems?.selectedIndex ?? 0;
      MainMenuState.rememberedSelectedIndex = 0;
    });

    FlxG.state.resetCamStuff();
  }

  function createMenuItem(name:String, atlas:String, id:Int, callback:Void->Void, fireInstantly:Bool):AtlasMenuItem
  {
    var item = new AtlasMenuItem(0, 0, name, Paths.getSparrowAtlas(atlas), callback);
    item.fireInstantly = fireInstantly;
    item.ID = id;

    item.scrollFactor.set(0, 0.4);

    // Set the offset of the item so the sprite is centered on the origin.
    item.centered = true;
    item.changeAnim('idle');

    return item;
  }

  function repositionMenuItems(menuItems:AtlasMenuList):Void
  {
    // Reset position of menu items.
    var spacing = 160;
    var top = (FlxG.height - (spacing * (menuItems.length - 1))) / 2;
    for (i in 0...menuItems.length)
    {
      var menuItem = menuItems.members[i];
      menuItem.x = FlxG.width / 2;
      menuItem.y = top + spacing * i;
      menuItem.ID = i;
      if (menuItem.ID != FlxG.state.menuItems.selectedIndex) menuItem.idle();
    }
  }
}
