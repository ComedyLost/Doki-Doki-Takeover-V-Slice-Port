import funkin.play.PlayState;
import funkin.play.event.SongEvent;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.ui.options.FunkinSoundTray;
import openfl.display.Bitmap;

using StringTools;

class DokiSoundTray extends Module
{
  public function new()
  {
    super('DokiSoundTray');

    #if mobile
    active = false;
    #end
  }

  // Only Doki Stages
  var ddtoStages = ['schoolDDTO', 'schoolEvilDDTO', 'va11halla', 'dokiclubroom', 'dokifestival', 'dokiglitcher', 'musicroom', 'clubroomevil', 'youandme', 'wilted', 'libitina', 'va11halla'];
  var resetSoundTray:Bool;

  final GRAPHIC_SCALE:Float = 0.30;
  final BAR_COUNT:Int = 10;
  final BACKING_BAR_OPACITY:Float = 0.4;

  override function onSubStateOpenEnd(event)
  {
    if (event.targetState is PlayState)
    {
      resetSoundTray = true;
      createTray('ui/soundtraydoki');  
    } 
  }

  override function onStateChangeEnd(event)
  {
    if (event.targetState is PlayState)
    {
      resetSoundTray = true;
      createTray('ui/soundtraydoki');  
    } 
  }

  override function onSubStateCloseBegin(event)
  {
    if (event.targetState is PlayState && resetSoundTray)
    {
      resetSoundTray = false;
      createTray('ui/soundtray');  
    } 
  }

  override function onStateChangeBegin(event)
  {
    if (FlxG.state is PlayState && resetSoundTray)
    {
      resetSoundTray = false;
      createTray('ui/soundtray');  
    } 
  }


  override function onCountdownStart(event:ScriptEvent)
  {
    super.onCountdownStart(event);
    if (!ddtoStages.contains(PlayState.instance.currentStageId)) return;
    createTray('ui/soundtraydoki');
  }

  function createTray(path:String)
  {
    FlxG.sound.soundTray.removeChildren();

    var bg:Bitmap = new Bitmap(Assets.getBitmapData(Paths.image('$path/volume-box')));
    bg.scaleX = GRAPHIC_SCALE;
    bg.scaleY = GRAPHIC_SCALE;
    bg.smoothing = true;
    FlxG.sound.soundTray.addChild(bg);

    FlxG.sound.soundTray.y = -FlxG.sound.soundTray.height;
    visible = false;

    // makes an alpha'd version of all the bars (bar_10.png)
    var backingBar:Bitmap = new Bitmap(Assets.getBitmapData(Paths.image('$path/bars-10')));
    backingBar.x = 9;
    backingBar.y = 5;
    backingBar.scaleX = GRAPHIC_SCALE;
    backingBar.scaleY = GRAPHIC_SCALE;
    backingBar.smoothing = true;
    FlxG.sound.soundTray.addChild(backingBar);
    backingBar.alpha = BACKING_BAR_OPACITY;

    // clear the bars array entirely, it was initialized
    // in the super class
    FlxG.sound.soundTray._bars = [];

    final BAR_X_POS:Int = 9;
    final BAR_Y_POS:Int = 5;

    for (i in 1...(BAR_COUNT + 1))
    {
      var bar:Bitmap = new Bitmap(Assets.getBitmapData(Paths.image('$path/bars-${('$i'.lpad('0', 2))}')));
      bar.x = BAR_X_POS;
      bar.y = BAR_Y_POS;
      bar.scaleX = GRAPHIC_SCALE;
      bar.scaleY = GRAPHIC_SCALE;
      bar.smoothing = true;
      FlxG.sound.soundTray.addChild(bar);
      FlxG.sound.soundTray._bars.push(bar);
    }

    FlxG.sound.soundTray.screenCenter();
    FlxG.sound.soundTray.y = -FlxG.sound.soundTray.height - 10;

    FlxG.sound.soundTray.volumeUpSound = Paths.sound('$path/volume-up');
    FlxG.sound.soundTray.volumeDownSound = Paths.sound('$path/volume-down');
    FlxG.sound.soundTray.volumeMaxSound = Paths.sound('$path/volume-max');
  }

  override function onDestroy(event:ScriptEvent)
  {
    super.onDestroy(event);
    if (resetSoundTray) createTray('ui/soundtray');
  }
}
