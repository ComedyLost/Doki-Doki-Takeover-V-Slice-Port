import flixel.util.FlxTimer;
import funkin.Highscore;
import funkin.graphics.FunkinSprite;
import funkin.play.ResultState;
import funkin.play.PlayState;
import funkin.modding.module.Module;
import funkin.graphics.FunkinBackdrop;
import funkin.audio.FunkinSound;
import flixel.FlxCamera;
import funkin.graphics.FunkinCamera;
import funkin.play.scoring.Scoring;
import flixel.effects.FlxFlicker;
import StringTools;
import funkin.data.freeplay.player.PlayerRegistry;
import funkin.graphics.ScriptedFunkinSprite;
import funkin.ui.FullScreenScaleMode;

class DDTOResults extends Module
{
  public function new()
  {
    super("DDTOResultsScreen", null, {state: PlayState});
  }

  var whiteBackground:FunkinSprite;
  var dokiBackdrop:FunkinBackdrop;
  var creditsBG:FunkinBackdrop;
  var scanline:FunkinBackdrop;
  var gradient:FunkinSprite;
  var isDoki:Bool;
  var rank:String;

  function getRank(?params)
  {
    var rank:String = Std.string(Scoring.calculateRank(params.scoreData));
    if (rank == "PERFECT_GOLD") return "PERFECT";
    else if (rank == "SHIT") return "LOSS";
    else
      return rank;
  }

  public function getBFDelay():Float
  {
    switch (rank)
    {
      case "PERFECT_GOLD", "PERFECT":
        // return 2.5;
        return 95 / 24;
      case "EXCELLENT":
        return 97 / 24;
      case "GREAT":
        return 95 / 24;
      case "GOOD":
        return 95 / 24;
      case "LOSS":
        return 95 / 24;
      default:
        return 3.5;
    }
  }

  public function getFlashDelay():Float
  {
    switch (rank)
    {
      case "PERFECT_GOLD", "PERFECT":
        // return 2.5;
        return 129 / 24;
      case "EXCELLENT":
        return 122 / 24;
      case "GREAT":
        return 109 / 24;
      case "GOOD":
        return 107 / 24;
      case "LOSS":
        return 186 / 24;
      default:
        return 3.5;
    }
  }

  override function onSubStateOpenEnd(event)
  {
    super.onSubStateOpenEnd(event);
    if (Std.isOfType(event.targetState, ResultState))
    {
      if (!isDoki) return;
      var state = event.targetState;
      var dokiCharacters = ['monika', 'yuri', 'natsuki', 'yuri', 'protag'];

      var characterDoki:Bool = false;

      for (character in dokiCharacters)
      {
        if (characterDoki) break;
        if (StringTools.contains(state.params.characterId, character)) characterDoki = true;
      }
      if (characterDoki)
      {
        var dokis:FunkinSprite = FunkinSprite.createSparrow(310 + FullScreenScaleMode.gameCutoutSize.x / 2, -200, "ui/doki-main-menu/characters/dokitogether");
        dokis.scale.set(0.6, 0.6);
        dokis.animation.addByPrefix('idle', 'Doki together club', 24, true, false, false);
        dokis.animation.play('idle', true, false, 0);
        dokis.visible = false;
        state.add(dokis);
        state.refresh();
        new FlxTimer().start(getFlashDelay(), _ ->
        {
          dokis.visible = true;
        });
        for (sprite in state.characterSparrowAnimations)
        {
          sprite.sprite.alpha = 0;
        }
        for (atlas in state.characterAtlasAnimations)
        {
          atlas.sprite.alpha = 0;
        }
      }
    }
  }

  public function onSubStateOpenBegin(event)
  {
    super.onSubStateOpenBegin(event);
    if (Std.isOfType(event.targetState, ResultState))
    {
      var state = event.targetState;
      isDoki = switch (state.params.characterId)
      {
        case "bf-doki", "pixelbf-new", "pixelbfangry-new", "bf-pixelbar", "monika", "sayori", "yuri", "natsuki", "protag", "playablegf", "pico-doki",
          "spooky-doki": true;
        default: false;
      }
      if (!isDoki) return;
      #if SpookyMix
      if (state.params.characterId == 'spooky-doki') state.params.characterId = 'spooky';
      #end
      rank = getRank(state.params);
      state.rankVertAsset = Paths.image("ui/results/rank-text/doki/text-" + rank.toLowerCase());
      state.rankBackAsset = Paths.image("ui/results/rank-text/doki/scroll-" + rank.toLowerCase());

      state.rankBg.alpha = 0;
      state.resultsAnim = FunkinSprite.createSparrow(-200, -10, "ui/results/interface/results-doki");
      // Background
      whiteBackground = new FunkinSprite();
      whiteBackground.makeGraphic(FlxG.width, FlxG.height, 0xFFFFFFFF);
      whiteBackground.screenCenter();
      whiteBackground.zIndex = 11;
      whiteBackground.cameras = [state.cameraBG];
      whiteBackground.alpha = 1;

      dokiBackdrop = new FunkinBackdrop(Paths.image('ui/doki-general/scrolling-bg'));
      dokiBackdrop.scrollFactor.set(0.1, 0.1);
      dokiBackdrop.velocity.set(-10, 0);
      dokiBackdrop.zIndex = 12;
      dokiBackdrop.cameras = [state.cameraBG];
      dokiBackdrop.alpha = 0.3;

      creditsBG = new FunkinBackdrop(Paths.image('gameplay/stages/credits/poc-background'));
      creditsBG.scrollFactor.set(0.1, 0.1);
      creditsBG.zIndex = 13;
      creditsBG.cameras = [state.cameraBG];
      creditsBG.velocity.set(-50, 0);

      scanline = new FunkinBackdrop(Paths.image('gameplay/stages/credits/scanlines'));
      scanline.scrollFactor.set(0.1, 0.1);
      scanline.zIndex = 14;
      scanline.cameras = [state.cameraBG];
      scanline.velocity.set(0, 20);

      gradient = new FunkinSprite().loadGraphic(Paths.image('gameplay/stages/credits/gradent'));
      gradient.scrollFactor.set(0.1, 0.1);
      gradient.screenCenter();
      gradient.zIndex = 15;
      gradient.cameras = [state.cameraBG];
      gradient.setGraphicSize(Std.int(gradient.width * 1.6));

      state.add(whiteBackground);
      state.add(dokiBackdrop);
      state.add(creditsBG);
      state.add(scanline);
      state.add(gradient);
    }
  }
}
