import funkin.graphics.FunkinSprite;
import flixel.util.FlxTimer;
import funkin.ui.MusicBeatSubState;
import funkin.graphics.FunkinCamera;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.Module;
import funkin.util.TouchUtil;
import funkin.audio.FunkinSound;

class CatfightPopup extends MusicBeatSubState
{
  var canpressbuttons:Bool = false;

  var curSelected:Int = 1;
  var selectGrp:Array<FunkinSprite>;
  var mainCam:FunkinCamera;

  public function new()
  {
    super();
  }

  public override function create():Void
  {
    super.create();

    selectGrp = [];

    mainCam = new FunkinCamera('MainCam');
    FlxG.cameras.add(mainCam, false);
    mainCam.bgColor = 0x0;
    mainCam.visible = true;

    var background:FunkinSprite = new FunkinSprite(0, 0).makeGraphic(FlxG.width, FlxG.height, 0xFFFFFFFF);
    background.alpha = 0.5;
    background.cameras = [mainCam];
    add(background);

    var select:FunkinSprite = new FunkinSprite(0, 40).loadGraphic(Paths.image('ui/catfight-select/select-text'));
    select.scale.set(0.8, 0.8);
    select.updateHitbox();
    select.screenCenter(0x01);
    select.cameras = [mainCam];
    add(select);

    var yuri:FunkinSprite = new FunkinSprite(0, 0).loadGraphic(Paths.image('ui/catfight-select/yuri-catfight'));
    yuri.scale.set(0.6, 0.6);
    yuri.updateHitbox();
    yuri.screenCenter();
    yuri.x -= 300;
    yuri.y += 60;
    yuri.cameras = [mainCam];
    add(yuri);

    var natsuki:FunkinSprite = new FunkinSprite(0, 0).loadGraphic(Paths.image('ui/catfight-select/natsuki-catfight'));
    natsuki.scale.set(0.6, 0.6);
    natsuki.updateHitbox();
    natsuki.screenCenter();
    natsuki.x += 300;
    natsuki.y += 60;
    natsuki.cameras = [mainCam];
    add(natsuki);

    selectGrp.push(yuri);
    selectGrp.push(natsuki);

    new FlxTimer().start(0.2, function(tmr:FlxTimer)
    {
      canpressbuttons = true;
    });

    changeItem(0, false);
  }

  override function update(elapsed:Float):Void
  {
    super.update(elapsed);

    if (canpressbuttons)
    {
      if (controls.BACK_P)
      {
        FunkinSound.playOnce(Paths.sound('ui/doki-main-menu/cancel-menu'));

        FlxG.state.subState.persistentUpdate = true;
        close();
      }

      #if FEATURE_TOUCH_CONTROLS
      if (TouchUtil.justPressed && (TouchUtil.pressAction(selectGrp[0]) || TouchUtil.pressAction(selectGrp[1])))
      {
        for (i in 0...selectGrp.length)
        {
          if (!TouchUtil.pressAction(selectGrp[i])) continue;

          if (curSelected != i)
          {
            curSelected = i;
            changeItem();
          }
          else
          {
            ModuleHandler.getModule("CatFightFreeplayFix").detectYuri(curSelected);
            close();
          }
        }
      }
      #end

      if (controls.NOTE_LEFT_P) changeItem(-1);
      if (controls.NOTE_RIGHT_P) changeItem(1);

      if (controls.ACCEPT_P)
      {
        ModuleHandler.getModule("CatFightFreeplayFix").detectYuri(curSelected);
        close();
      }
    }
  }

  function changeItem(amt:Int = 0, ?playSound = true):Void
  {
    if (playSound) FunkinSound.playOnce(Paths.sound('ui/doki-main-menu/scroll-menu'));

    curSelected += amt;

    if (curSelected > 1) curSelected = 0;
    if (curSelected < 0) curSelected = 1;

    for (sel in selectGrp)
    {
      sel.color = 0xFF808080;
      if (selectGrp[curSelected] == sel) sel.color = 0xFFFFFFFF;
    }
  }
}
