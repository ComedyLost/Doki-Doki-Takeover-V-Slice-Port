import flixel.util.FlxSave;

class DokiPreferences
{
  public static var save(get, never):FlxSave;

  static var _save:Null<FlxSave> = null;

  static function get_save():FlxSave
  {
    if (_save == null)
    {
      _save = new FlxSave();
      _save.bind("TakeoverOptions", "FunkinCrew");
      _save.mergeData(getDefaultSave(), false);
    }
    return _save;
  }

  public static final TITLESCREEN_OPTIONS:Map<String> = ['None' => 'none', 'Title Only' => 'title', 'All Menus' => 'all']; 

  public static var menus(get, set):FlxSave;

  static function get_menus():FlxSave
  {
    return save.data.menus;
  }

  static function set_menus(value:Bool):FlxSave
  {
    save.data.menus = value;
    flush();
    return value;
  }

  public static var menus(get, set):FlxSave;

  static function get_menus():FlxSave
  {
    return save.data.menus;
  }

  static function set_menus(value:Bool):FlxSave
  {
    save.data.menus = value;
    flush();
    return value;
  }

