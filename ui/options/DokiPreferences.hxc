  public static function flush():Void
  {
    save.flush();
  }

  public static function getDefaultSave():Dynamic
  {
    return {
      menus: 'title',
      chrcheck: true,
      selfaware: true,
      gfCountdown: true,
      bloom: true,
      freeplayDialogue: true,
      cool: false,
      markov: true,
      random: false,
      pixel: false,
      psychholds: false,
      nowidescreen: false
    }
  }
