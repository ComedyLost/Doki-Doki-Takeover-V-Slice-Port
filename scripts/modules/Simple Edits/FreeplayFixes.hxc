import funkin.modding.module.Module;
import funkin.ui.freeplay.FreeplayState;
import funkin.util.ReflectUtil;
import funkin.ui.freeplay.SongMenuItem;
import funkin.audio.FunkinSound;
import funkin.modding.base.ScriptedMusicBeatSubState;
import StringTools;
import flixel.util.FlxTimer;
import funkin.PlayerSettings;
import funkin.util.TouchUtil;
import funkin.util.SwipeUtil;
import funkin.mobile.input.ControlsHandler;
import funkin.data.song.SongRegistry;
import funkin.util.FileUtil;
import funkin.modding.PolymodHandler;
import funkin.ui.UIState;
import funkin.modding.module.ModuleHandler;

using StringTools;

class DokiFreeplayFixes extends Module
{
  public function new()
  {
    super('DokiFreeplayFixes');

    save = DokiPreferences.getDokiSave();
  }

  var DokiKillHandler:ModuleHandler = ModuleHandler.getModule("KillDoki");

  var ddtolevelids = ['DDTOWeek1', 'DDTOWeek2', 'DDTOWeek3', 'DDTOWeek4', 'DDTOWeek5', 'DDTOWeek6', 'DDTOWeek7', 'DDTOWeek8', 'DDTOWeekFanmade', 'ExtraDDTOFreeplaySongs', 'ExtraDDTOSecretSongs', 'ExtraDDTOSideStories', 'fuckidk'];

  function file(path:String)
  {
    return DokiKillHandler.file(path);
  }

  function dokiCheck(cap:SongMenuItem, originalCallback:Void->Void)
  {
    var curSong = cap?.freeplayData?.data;
    if (curSong == null) return;
    FlxG.state.subState.persistentUpdate = false;
    FlxG.state.subState.uiStateMachine.transition(UIState.Exiting);
    var variations:Array<String> = curSong.getVariationsByCharacterId(FreeplayState.rememberedCharacterId);
    var playerChar = curSong.getDifficulty(FreeplayState.rememberedDifficulty, null, variations)?.characters.player ?? '';
    for (dokis in ['monika', 'yuri', 'sayori', 'natsuki'])
    {
      if (playerChar.contains(dokis))
      {
        if (!FileUtil.fileExists(file('chrs/' + dokis + '.chr')) ?? false)
        {
          FlxG.state.subState.openSubState(new DokiMissingSubState());
        }
        else
        {
          originalCallback();
        }
        break;
      }
    }
  }

  function customDisplay(cap:SongMenuItem)
  {
    if (cap?.freeplayData == null) return;
    if (!FlxG.onMobile && save?.chrcheck)
    {
      var capsule = cap; // oh...
      for (dokis in ['monika', 'yuri', 'sayori', 'natsuki'])
      {
        var curSong = cap?.freeplayData?.data;
        if (curSong == null) break;
        if (curSong.id == 'catfight') break;
        var variations:Array<String> = curSong.getVariationsByCharacterId(FreeplayState.rememberedCharacterId);
        var playerChar = curSong.getDifficulty(FreeplayState.rememberedDifficulty, null, variations)?.characters.player ?? '';
        if (playerChar.contains(dokis))
        {
          var original:Void->Void = capsule.onConfirm;
          capsule.onConfirm = function()
          {
            dokiCheck(capsule, original);
          };
          break;
        }
      }
    }
    if (cap.pixelIcon.animation.curAnim == null || cap.pixelIcon.animation.curAnim.name == 'idle')
    {
      var oldIcon = cap.freeplayData.songCharacter;
      switch (cap.freeplayData.songCharacter)
      {
        case 'monika', 'monika-pixelnew', 'duetnew':
          cap.pixelIcon.setCharacter('monika');
        case 'bigmonika', 'bigmonika-dress', 'monika-angry':
          cap.pixelIcon.setCharacter('monika-epiphany');
        case 'senpai-ddto', 'senpai-angry-ddto', 'senpai-nonpixel':
          cap.pixelIcon.setCharacter('senpai');
      }
      switch (cap.freeplayData.data.id)
      {
        case "your-demise":
          cap.pixelIcon.setCharacter('monika-epiphany');
        case "our-harmony":
          cap.pixelIcon.setCharacter('monika');
        case "you-and-me":
          cap.pixelIcon.setCharacter('protag');
        case "constricted":
          cap.pixelIcon.setCharacter('sayori');
        case "libitina":
          cap.pixelIcon.setCharacter('libitina');
        case "love-n-funkin":
          switch (FlxG.state.subState.currentVariation)
          {
            case 'pico': cap.pixelIcon.setCharacter('pico');
            case Constants.DEFAULT_VARIATION: cap.pixelIcon.setCharacter('gf');
          }
      }
      cap.pixelIcon.char = oldIcon;
    }
  }

  public function onDifficultySwitch(event:CapsuleScriptEvent):Void
  {
    super.onDifficultySwitch(event);
    var filteredCapsules:Array<SongMenuItem> = FlxG.state.subState.grpCapsules.members.filter(function(cap:SongMenuItem)
    {
      // Dead capsules are ones which were removed from the list when changing filters.
      return cap != null && cap.alive && cap.freeplayData != null && ddtolevelids.contains(cap.freeplayData.levelId);
    });
    for (capsule in filteredCapsules)
    {
      if (capsule == null || !capsule.alive) continue;

      customDisplay(capsule);
    }
  }

  public function onCapsuleSelected(event:CapsuleScriptEvent):Void
  {
    super.onCapsuleSelected(event);
    if (event.capsule?.freeplayData != null)
    {
      switch (event.capsule.freeplayData.data.id)
      {
        case "your-demise":
          event.capsule.pixelIcon.setCharacter('monika-epiphany');
        case 'our-harmony':
          event.capsule.pixelIcon.setCharacter('monika');
        case 'love-n-funkin':
          switch (event.variationId)
          {
            case 'pico': event.capsule.pixelIcon.setCharacter('pico');
            case Constants.DEFAULT_VARIATION, null: event.capsule.pixelIcon.setCharacter('gf');
          }
      }
    }
  }
}
