import funkin.play.PlayState;
import funkin.modding.module.Module;
import funkin.util.Constants;

class DifficultySpriteFix extends Module
{
    function new() {
        super('DifficultySpriteFix');
    }    

	override function onCreate(event) {
		super.onCreate(event);

		if (!Constants.DEFAULT_DIFFICULTY_LIST_FULL.contains('alt')) Constants.DEFAULT_DIFFICULTY_LIST_FULL.push("alt");
		if (!Constants.DEFAULT_DIFFICULTY_LIST_FULL.contains('lyrics')) Constants.DEFAULT_DIFFICULTY_LIST_FULL.push("lyrics");
    }    
}