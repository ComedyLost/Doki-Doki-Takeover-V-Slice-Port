import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.Preferences;
import funkin.PlayerSettings;
import funkin.Highscore;
import funkin.audio.FunkinSound;
import funkin.Paths;
import flixel.FlxG;
import funkin.ui.options.OptionsState;
import flixel.FlxG;
import funkin.save.Save;
import funkin.ui.options.PreferencesMenu;

class DokiPreferences extends Module
{
	var defaultOptions = {
		titlescreen: true,
		menus: false,
		selfaware: true,
		gfCountdown: true,
		bloom: true,
		freeplayDialogue: true,
		cool: false,
		markov: true,
		random: false,
		pixel: false,
		psychholds: false,
		costumesanywhere: false
	};

	
	public static var titlescreen(get, set):Bool;

	static function get_titlescreen():Bool {
    	return save?.titlescreen ?? true;
  	}

 	static function set_titlescreen(value:Bool):Bool {
    	save.titlescreen = value;
    	Save.instance.flush();
    	return value;
  	}

	public static var menus(get, set):Bool;

	static function get_menus():Bool {
    	return save?.menus ?? false;
  	}

 	static function set_menus(value:Bool):Bool {
    	save.menus = value;
    	Save.instance.flush();
    	return value;
  	}

	public static var selfaware(get, set):Bool;

	static function get_selfaware():Bool {
    	return save?.selfaware ?? true;
  	}

 	static function set_selfaware(value:Bool):Bool {
    	save.selfaware = value;
    	Save.instance.flush();
    	return value;
  	}

