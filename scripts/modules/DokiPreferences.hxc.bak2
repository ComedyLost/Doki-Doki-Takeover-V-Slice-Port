 	static function set_bloom(value:Bool):Bool {
    	save.bloom = value;
    	Save.instance.flush();
    	return value;
  	}

	public static var freeplayDialogue(get, set):Bool;

	static function get_freeplayDialogue():Bool {
    	return save?.freeplayDialogue ?? true;
  	}

 	static function set_freeplayDialogue(value:Bool):Bool {
    	save.freeplayDialogue = value;
    	Save.instance.flush();
    	return value;
  	}

	public static var cool(get, set):Bool;

	static function get_cool():Bool {
    	return save?.cool ?? false;
  	}

 	static function set_cool(value:Bool):Bool {
    	save.cool = value;
    	Save.instance.flush();
    	return value;
  	}

