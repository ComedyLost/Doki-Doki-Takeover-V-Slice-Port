import funkin.modding.module.Module;
import flixel.FlxG;
import funkin.Paths;
import funkin.ui.freeplay.FreeplayState;
import funkin.util.ReflectUtil;
import funkin.ui.freeplay.SongMenuItem;
import funkin.ui.freeplay.DifficultyDot;

import StringTools;

class DifficultyOrderFix extends Module {
	public function new(){
		super('DifficultyOrderFix');

		active = false;
	}
	
	override function onSubStateOpenEnd(event) {
        super.onSubStateOpenEnd(event);

        if (Std.isOfType(event.targetState, FreeplayState)) {
			fixOrder(event.targetState);
		}
	}

	//Fix the order of the difficulties
	function fixOrder(state){
		var defaultDiffs = ['easy', 'normal', 'hard', 'erect', 'nightmare'];
		var oldDiffs = [];
		for (dots in state.difficultyDots.members) {
			oldDiffs.push(dots.difficultyId);
			dots.kill();
    	}
		state.difficultyDots.clear();
		for (diffs in defaultDiffs) { //Prevent the game from adding difficulties that don't exist for the character
			if (!oldDiffs.contains(diffs)) defaultDiffs.remove(diffs);
		}
		for (diffs in oldDiffs){
			if (defaultDiffs.contains(diffs)) oldDiffs.remove(diffs);
		}
		var newOrder = defaultDiffs;
		for (diffs in oldDiffs){
			if (!newOrder.contains(diffs)) newOrder.push(diffs);
		}
		trace(newOrder);
		for (i in 0...newOrder.length) {
     		var dot:DifficultyDot = new DifficultyDot(newOrder[i], i);
      		if (dot.difficultyId == 'erect' || dot.difficultyId == 'nightmare') {
        		dot.targetType = DotType.ERECT;
      		}
      		state.difficultyDots.add(dot);
    	}
		state.refreshDots(5, newOrder.indexOf(state.currentDifficulty), newOrder.indexOf(state.currentDifficulty));
	}
}