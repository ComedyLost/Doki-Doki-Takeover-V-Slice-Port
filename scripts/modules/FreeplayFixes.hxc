import funkin.modding.module.Module;
import flixel.FlxG;
import funkin.Paths;
import funkin.ui.freeplay.FreeplayState;
import funkin.util.ReflectUtil;
import funkin.ui.freeplay.SongMenuItem;
import funkin.audio.FunkinSound;
import funkin.modding.base.ScriptedMusicBeatSubState;
import StringTools;
import flixel.util.FlxTimer;
import funkin.PlayerSettings;
import funkin.util.TouchUtil;
import funkin.util.SwipeUtil;
import funkin.mobile.input.ControlsHandler;

using StringTools;

class FreeplayFixes extends Module {
	public function new(){
		super('FreeplayFixes', 1, {state: FreeplayState});
	}

	var ddtolevelids = ['DDTOWeek1', 'DDTOWeek2', 'DDTOWeek3', 'DDTOWeek4', 'DDTOWeek5', 'DDTOWeek6', 'DDTOWeek7', 'DDTOWeek8', 'DDTOWeekDoggle', 'ExtraDDTOFreeplaySongs', 'ExtraDDTOSecretSongs', 'ExtraDDTOSideStories', 'fuckidk'];
	var curSelected:Int;

	var changedCapsules:Array<SongMenuItem>;
	var changeSelectionCallback:String->Void;

	override function onSubStateOpenEnd(event) {
        super.onSubStateOpenEnd(event);
		if (!(event.targetState is FreeplayState)) return;
		var state = event.targetState;
		changedCapsules = [];
		changeSelectionCallback = state.letterSort.changeSelectionCallback;
		state.letterSort.changeSelectionCallback = (str) -> {
			changeSelectionCallback(str);
			checkCapsules();
		};
		var filteredCapsules:Array<SongMenuItem> = FlxG.state.subState.grpCapsules.members.filter(function(cap:SongMenuItem) {
       		// Dead capsules are ones which were removed from the list when changing filters.
        	return cap != null && cap.alive && cap.freeplayData != null && ddtolevelids.contains(cap.freeplayData.levelId);
      	});
		for (capsule in filteredCapsules){
			if (capsule == null || !capsule.alive) continue;

			changedCapsules.push(capsule); // Push these changed capsules
			customDisplay(capsule);
		}	
	}

	function customDisplay(cap:SongMenuItem) {
		if (cap?.freeplayData == null) return;
		cap.weekType.visible = true;
		cap.weekType.frames = Paths.getSparrowAtlas('freeplay/freeplayCapsule/takeoverweektypes');
		cap.weekType.animation.addByPrefix('TAKEOVER', 'TAKEOVER text instance 1', 24, false);
		cap.weekType.animation.addByPrefix('TF', 'what the fuck instance 1', 24, false);
		switch (cap.freeplayData.data.id) {
			case 'mstsoobf': cap.weekType.animation.play('TF', true);
			default: cap.weekType.animation.play('TAKEOVER', true);
		}
		if (cap.pixelIcon.animation.curAnim == null || cap.pixelIcon.animation.curAnim.name == 'idle'){
			switch (cap.freeplayData.songCharacter){
				case 'monika', 'monika-pixelnew', 'duetnew':
					cap.pixelIcon.setCharacter('monika');
				case 'bigmonika', 'bigmonika-dress', 'monika-angry': 
					cap.pixelIcon.setCharacter('monika-epiphany');
				case 'senpai-ddto', 'senpai-angry-ddto', 'senpai-nonpixel':
					cap.pixelIcon.setCharacter('senpai');	
			}
			switch (cap.freeplayData.data.id){
				case "your-demise": cap.pixelIcon.setCharacter('monika-epiphany');
				case "our-harmony": cap.pixelIcon.setCharacter('monika');
				case "you-and-me": cap.pixelIcon.setCharacter('protag');
				case "libitina": cap.pixelIcon.setCharacter('libitina');
				case "love-n-funkin":
					if (FlxG.state.subState.currentVariation == 'pico') cap.pixelIcon.setCharacter('pico');
					else cap.pixelIcon.setCharacter('gf');
			}
		}
	}
	
	function checkCapsules(){
		new FlxTimer().start(0.1, _ -> { // Add a small delay to grab the right capsules
			while (changedCapsules.length > 0) {
				var capsule = changedCapsules.shift();

				if (capsule.weekType.graphic.key.contains('freeplay/freeplayCapsule/takeoverweektypes')) resetCapsules(capsule);
			}
			if (changedCapsules.length != 0) changedCapsules = []; // Clear the array just in case
			var filteredCapsules:Array<SongMenuItem> = FlxG.state.subState.grpCapsules.members.filter(function(cap:SongMenuItem) {
       			// Dead capsules are ones which were removed from the list when changing filters.
        		return cap != null && cap.alive && cap.freeplayData != null && ddtolevelids.contains(cap.freeplayData.levelId);
      		});
			for (capsule in filteredCapsules){
				if (capsule == null || !capsule.alive) continue;

				changedCapsules.push(capsule); // Push these changed capsules
				customDisplay(capsule);
			}
		});			
	}

	function resetCapsules(cap:SongMenuItem) {
		if (cap?.freeplayData == null) return;
		cap.weekType.frames = Paths.getSparrowAtlas('freeplay/freeplayCapsule/weektypes');
		cap.weekType.animation.addByPrefix('WEEK', 'WEEK text instance 1', 24, false);
    	cap.weekType.animation.addByPrefix('WEEKEND', 'WEEKEND text instance 1', 24, false);
		cap.checkWeek(cap.freeplayData.data.id);
	}

	override function onUpdate(event:UpdateScriptEvent) {
		super.onUpdate(event);
		var switched = PlayerSettings.player1.controls.UI_LEFT_P || PlayerSettings.player1.controls.UI_RIGHT_P;
		if (!FlxG.onMobile || (FlxG.onMobile && (FlxG.state.subState.draggingDifficulty || ControlsHandler.usingExternalInputDevice))){
			var curCap = FlxG.state.subState.grpCapsules.members[FlxG.state.subState.curSelected];
			if (curCap?.freeplayData != null) {
				switch (curCap.freeplayData.data.id) {
					case "your-demise": if (!curCap.pixelIcon.graphic.key.contains("monika-epiphany")) curCap.pixelIcon.setCharacter('monika-epiphany');
					case 'our-harmony': if (!curCap.pixelIcon.graphic.key.contains("monika")) curCap.pixelIcon.setCharacter('monika');
					case 'love-n-funkin':
						if (FlxG.state.subState.currentVariation == 'pico' && !curCap.pixelIcon.graphic.key.contains("pico")) curCap.pixelIcon.setCharacter('pico');
						else if (!curCap.pixelIcon.graphic.key.contains("gf")) curCap.pixelIcon.setCharacter('gf');
				}
			}
		}
		//Prevents from running if the Freeplay state is busy (Ex. Choosing an inst, choosing a Doki for Catfight, first load, currently loading a song)
		if (FlxG.state.subState.controls.active && (switched || 
		TouchUtil.pressAction(FlxG.state.subState.diffSelLeft, FlxG.state.subState.funnyCam, false) || 
		TouchUtil.pressAction(FlxG.state.subState.diffSelRight, FlxG.state.subState.funnyCam, false) || 
		SwipeUtil.swipeLeft || SwipeUtil.swipeRight)){
			checkCapsules();
		}
	}
}