	function isRecording() { // All bypasses murdered :pensive:
		return ModStore.stores.exists('really.long.package.discord.ng.username');
	}

  	override function onCreate(event){
		super.onCreate(event);
		// NG = resolveClassEvilly('io.newgrounds.NG');
		if (save.selfaware) {
			if (isRecording()) _data.dialogue[4].text[0] = "\"And everyone tuning in can watch too. Are you excited, viewers?\"";
			else _data.dialogue[4].text[0] = "\"Isn't that right, " + getUsername() + "?\"";
		} else {
			// if (NG.core.loggedIn) _data.dialogue[4].text[0] = "\"Isn't that right, " + NG.core.user.name + "?\"";
			_data.dialogue[4].speed = 3;
			_data.dialogue[4].text[0] = "\"...\"";
			_data.dialogue[5].speed = 1;
		}
  	}

	  function getUsername(){
		if (ModStore.stores.exists('really.long.package.discord.ng.username')) return ModStore.get('really.long.package.discord.ng.username');
