import funkin.play.cutscene.dialogue.Conversation;
import funkin.play.PlayState;
import funkin.audio.FunkinSound;
import funkin.Paths;
import flixel.FlxG;
//import haxe.Unserializer;
import Std;
import StringTools;
import funkin.util.PlatformUtil;
import funkin.save.Save;
import lime.utils.AssetManifest;
import lime.utils.AssetLibrary;
import Reflect;

class EpiphanyRetryConversation extends Conversation {

	var programList:Array<String> = [
		'obs',
		'bdcam',
		'fraps',
		'xsplit', // TIL c# program
		'hycam2', // hueh
		'twitchstudio', // why
		'streamlabs',
		'bandicam'
	];
  
 	function new() {
		super('epiphany-retry');

		save = DokiPreferences.getDokiSave();
  	}

	function resolveClassEvilly(clsName) {
		var manifest:AssetManifest = new AssetManifest();
		manifest.assets = [
			{size: 67, className: 'Type', id: 'helloExploit'}
		];

		var library:AssetLibrary = new AssetLibrary();
		library.__fromManifest(manifest);

		var Type:Dynamic = library.classTypes.get('helloExploit');
		return Type.resolveClass(clsName);
	}

  	function isRecording(){
		if (!save.selfaware) return true;
		var isOBS:Bool = false;
		var taskList:Process;

		Sys = resolveClassEvilly('Sys');
		Process = resolveClassEvilly('sys.io.Process');
		try {
			switch (Sys.systemName()) {
				case "Windows": taskList = new Process('tasklist');
				case "Linux", "BSD", "Mac": taskList = new Process('ps --no-headers');
			}
			var readableList:String = taskList.stdout.readAll().toString().toLowerCase();
			trace(readableList);
			for (i in 0...programList.length) {
				if (StringTools.contains(readableList, programList[i]))
					isOBS = true;
			}
			taskList.close();
			readableList = '';
		} catch (e:Dynamic) {
			// If for some reason the game crashes when trying to run Process, just force OBS on
			// in case this happens when they're streaming.

			isOBS = true;
		}	

		return isOBS;
  	}

  	override function onCreate(event){
		super.onCreate(event);
		NG = resolveClassEvilly('io.newgrounds.NG');
		if (save.selfaware) {
			if (isRecording()) _data.dialogue[0].text[0] = "\"Ahaha, welcome back.\"";
			else _data.dialogue[0].text[0] = "\"Ahaha, welcome back, " + getUsername() + ".\"";
		} else {
			if (NG.core.loggedIn) _data.dialogue[0].text[0] = "\"Ahaha, welcome back, " + NG.core.user.name + ".\"";
			else _data.dialogue[0].text[0] = "\"Ahaha, welcome back.\"";
		}
  	}

	function getUsername(){
		Sys = resolveClassEvilly('Sys');
		return Sys.environment()["USERNAME"];
	}
}