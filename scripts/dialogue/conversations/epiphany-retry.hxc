import funkin.play.cutscene.dialogue.Conversation;
import funkin.play.PlayState;
import funkin.audio.FunkinSound;
import StringTools;
import funkin.save.Save;
import funkin.api.newgrounds.NewgroundsClient;

class EpiphanyRetryConversation extends Conversation
{
  // Murdered cuz whoopsies
  var programList:Array<String> = ['obs', 'bdcam', 'fraps', 'xsplit', // TIL c# program
    'hycam2', // hueh
    'twitchstudio', // why
    'streamlabs', 'bandicam'];

  function new()
  {
    super('epiphany-retry');

    save = DokiPreferences.getDokiSave();
  }

  override function onCreate(event)
  {
    super.onCreate(event);
    if (save.selfaware)
    {
      if (!NewgroundsClient.isLoggedIn()) _data.dialogue[0].text[0] = "\"Ahaha, welcome back.\"";
      else
        _data.dialogue[0].text[0] = "\"Ahaha, welcome back, " + getUsername() + ".\"";
    }
    else
    {
      _data.dialogue[0].text[0] = "\"Ahaha, welcome back.\"";
    }
  }

  function getUsername()
  {
    return NewgroundsClient.user.name;
  }
}
