import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.graphics.FunkinSprite;
import funkin.play.Countdown;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.FlxCamera;
import flixel.util.FlxTimer;
import funkin.ui.FullScreenScaleMode;

import Std;

class MusicRoomStage extends Stage
{
	function new()
	{
		super('musicroom');
	}

	override function buildStage() {
		super.buildStage();
		switch (PlayState.instance.currentSong.id.toLowerCase()){
			case "shrinking-violet":
				if (PlayState.instance.currentVariation == 'alt') getNamedProp('Music Room BG').loadGraphic(Paths.image('musicroom/Music_RoomSpooky'));
			case "love-n-funkin":
				getNamedProp('Music Room BG').loadGraphic(Paths.image('musicroom/Music_RoomLNF'));
		}
		if (PlayState.instance.camGame.width > FlxG.initialWidth) {
			// Lock camGame width on longer devices to prevent out of bounds from showing
			PlayState.instance.camGame.width = FlxG.initialWidth;
			PlayState.instance.camGame.x = FlxG.width / 2 - PlayState.instance.camGame.width / 2;
		}
	}
}