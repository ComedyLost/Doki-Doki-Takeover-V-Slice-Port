  var charFile:String;
}

// This code fucking sucks ass 😭

class CharacterLineUp extends Module
{
  public function new()
  {
    super('CharacterLineUp');

    active = false;
  }

  var hasLoaded:Bool = false;

  override function onSubStateCloseBegin(event)
  {
    if (event.targetState is PlayState) hasLoaded = false;
  }

  override function onStateChangeBegin(event)
  {
    if (FlxG.state is PlayState) hasLoaded = false;
  }

  // Cache costume textures to prevent lag
  override function onSongLoaded(event)
  {
    super.onSongLoaded(event);
    if (PlayState.instance?.currentStage == null || PlayState.instance.isMinimalMode) return;

    if (!hasLoaded)
    {
      var currentStage:Stage = PlayState.instance.currentStage;
      var character = createCharacter('bigmonika-dress');
      trace('POS: ${currentStage.getDad().originalPosition} | ${character.originalPosition}');
      trace('CAM: ${currentStage.getDad().cameraFocusPoint} | ${character.cameraFocusPoint}');

      return;
      for (characterId in ['monika', 'sayori', 'yuri', 'natsuki'])
      {
        createCharacter(characterId);
      }
    }
  }

  function createCharacter(charId:String):BaseCharacter
  {
    var currentStage:Stage = PlayState.instance.currentStage;
    if (charId == currentStage.getDad().characterId) continue;
    var currentDad:BaseCharacter = currentStage.getDad();
    var character:BaseCharacter = CharacterDataParser.fetchCharacter(charId);
    currentStage.addCharacter(character, CharacterType.DAD);
    currentStage.characters.set('dad', currentDad);
    currentStage.characters.set(charId, character);
    return character;
  }
}
