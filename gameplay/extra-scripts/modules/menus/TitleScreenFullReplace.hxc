import funkin.ui.story.StoryMenuState;
import funkin.save.Save;
import funkin.Conductor;
import funkin.ui.title.AttractState;
import funkin.audio.FunkinSound;
import funkin.modding.module.Module;
import funkin.InitState;

class TitleScreenReplace extends Module
{
  public function new()
  {
    super('TitleScreenReplace');

    save = DokiPreferences.getDokiSave();
  }

  var titleState:Bool = false;

  public override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    if (!titleState)
    {
      // Tells the game to go to our menu instead of the TitleState!
      InitState.customTitleState = new DokiTitleState();
      titleState = true; // if this was called again, just so it doesn't get created once more. (It shouldn't)
    }
  }
}
