import funkin.play.PlayState;
import funkin.graphics.shaders.WiggleEffectRuntime;
import funkin.graphics.shaders.WiggleEffectType;
import flixel.addons.effects.FlxTrail;
import flixel.tweens.FlxTween;
import funkin.graphics.FunkinSprite;
import flixel.util.FlxTimer;
import funkin.audio.FunkinSound;
import flixel.tweens.FlxEase;
import funkin.play.song.Song;
import funkin.play.Countdown;
import funkin.Conductor;
import funkin.util.FlxTweenUtil;
import funkin.play.PlayStatePlaylist;
import ddto.cutscene.DokiConversationSystem;
import funkin.save.Save;

class HotAirBalloonSong extends Song
{
  function new()
  {
    super('hot-air-balloon');
  }

  var bakaOverlay:FunkinSprite;
  var hasPlayedIntroCutscene:Bool;
  var hasPlayedOutroCutscene:Bool;

  public override function isSongNew(currentDifficulty:String):Bool
  {
    if (!Save.instance.hasBeatenSong(this.id)) return true;
    else
      return false;
  }

  override function onCreate(event)
  {
    super.onCreate(event);
    if (PlayState.instance?.currentStage == null || PlayState.instance.isMinimalMode) return;
    
    hasPlayedIntroCutscene = hasPlayedOutroCutscene = false;

    bakaOverlay = new FunkinSprite(0, 0);
    bakaOverlay.frames = Paths.getSparrowAtlas('clubroom/BakaBGDoodles');
    bakaOverlay.animation.addByPrefix('normal', 'Normal Overlay', 24, true);
    bakaOverlay.animation.addByPrefix('party rock is', 'Rock Overlay', 24, true);
    bakaOverlay.animation.addByPrefix('FUCK', 'Tank Overlay', 24, true);
    bakaOverlay.animation.play('normal');
    bakaOverlay.scrollFactor.set();
    bakaOverlay.zIndex = 400;
    bakaOverlay.alpha = 0;
    bakaOverlay.cameras = [PlayState.instance.camHUD];
    bakaOverlay.setGraphicSize(Std.int(FlxG.width));
    bakaOverlay.updateHitbox();
    bakaOverlay.screenCenter();
    PlayState.instance.add(bakaOverlay);
  }

  function calcSectionLength(?duration:Int = 1)
  {
    if (duration == null) duration = 1;
    var durSeconds = (Conductor.instance.stepLengthMs * (16 * duration)) / 1000;
    return durSeconds;
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    hasPlayedIntroCutscene = true;
    FlxTween.cancelTweensOf(bakaOverlay);
    bakaOverlay.alpha = 0;
    bakaOverlay.animation.play('normal');
  }

  function onStepHit(event:SongTimeScriptEvent):Void
  {
    switch (event.step)
    {
      case 1024:
        // defaultCamZoom = 1.35;
        FlxTween.tween(bakaOverlay, {alpha: 1}, calcSectionLength(), {ease: FlxEase.sineIn});
      case 1280:
        // defaultCamZoom = 1;
        FlxTween.tween(bakaOverlay, {alpha: 0}, calcSectionLength(2), {ease: FlxEase.sineOut});
    }
  }
  
  public override function onSongEnd(event:CountdownScriptEvent):Void
  {
    super.onSongEnd(event);
    if (!PlayStatePlaylist.isStoryMode) hasPlayedOutroCutscene = true;

    if (!hasPlayedOutroCutscene)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedOutroCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camCutscene.visible = true;

      startEndDialogue();
    }
  }
  
  function startEndDialogue()
  {
    DokiConversationSystem.startConversation('${this.id}', 'End');
    DokiConversationSystem.dialogueBox.completeCallback = () -> {
      DokiConversationSystem.onConversationComplete();
      PlayState.instance.endSong();
    }
  }

  public function onCountdownStart(event):Void
  {
    super.onCountdownStart(event);
    if (!PlayStatePlaylist.isStoryMode) hasPlayedIntroCutscene = true;
    if (!hasPlayedIntroCutscene)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedIntroCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      startDialogue();
    }
  }
  
  public function playbackCutscene(?cutsceneType:String)
  {
    PlayState.instance.currentStage.getDad().visible = true;
  }

  function startDialogue()
  {
    PlayState.instance.currentStage.getDad().visible = false;
    var gfPoint = PlayState.instance.currentStage.getGirlfriend().cameraFocusPoint;
    var targetX = gfPoint.x;
    var targetY = gfPoint.y - 150;
    PlayState.instance.tweenCameraToPosition(targetX, targetY, 0);
    DokiConversationSystem.startConversation('${this.id}');
  }
}
