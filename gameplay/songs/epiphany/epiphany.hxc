import funkin.play.PlayState;
import funkin.play.song.Song;
import flixel.tweens.FlxTween;
import funkin.graphics.FunkinSprite;
import flixel.util.FlxTimer;
import funkin.audio.FunkinSound;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import funkin.play.cutscene.dialogue.DialogueBox;
import funkin.play.PlayStatePlaylist;
import flixel.tweens.FlxEase;
import funkin.save.Save;
import funkin.Conductor;

using funkin.util.tools.MapTools;

class EpiphanySong extends Song
{
  var hasPlayedCutscene:Bool;

  function new()
  {
    super('epiphany');

    save = DokiPreferences.getDokiSave();
  }

  public override function listAltInstrumentalIds(difficultyId:String, variationId:String):Array<String>
  {
    // This song for some reason had the alt instrumental pop-up, this is here to remove that pop-up
    return [];
  }

  override function onUpdate(event:UpdateScriptEvent)
  {
    super.onUpdate(event);
    if (PlayState.instance?.currentStage == null || PlayState.instance.isMinimalMode) return;
    if (PlayState.instance.currentVariation != 'lyrics') return;
    processNotes(event);
  }

  function processNotes(elapsed:Float):Void
  {
    // Process hold notes on the opponent's side.
    for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members)
    {
      if (holdNote == null || !holdNote.alive) continue;

      // While the hold note is being hit, and there is length on the hold note...
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 100)
      {
        // Make sure the opponent keeps singing while the note is held.
        if (PlayState.instance.currentStage.getDad().isSinging()) PlayState.instance.currentStage.getDad().animation.curAnim.restart();
      }
    }
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    if (PlayState.instance.isChartingMode && !hasPlayedCutscene) hasPlayedCutscene = true;

    if (!hasPlayedCutscene && save.freeplayDialogue)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camHUD.visible = false;

      transitionToDialogue();
    }
  }

  function transitionToDialogue()
  {
    trace('Transitioning to dialogue.');

    PlayState.instance.camCutscene.visible = true;

    var black:FunkinSprite = new FunkinSprite(-20, -20).makeSolidColor(FlxG.width * 1.5, FlxG.height * 1.5, 0xFF000000);
    black.cameras = [PlayState.instance.camCutscene];
    black.zIndex = 1000000;
    PlayState.instance.add(black);

    black.alpha = 1.0;

    var tweenFunction = function(x)
    {
      var xSnapped = Math.floor(x * 8) / 8;
      black.alpha = 1.0 - xSnapped;
    };

    FlxTween.num(0.0, 1.0, 2.0, {
      ease: FlxEase.linear,
      startDelay: 0.25,
      onComplete: function(input)
      {
        // black.visible = false;
        startDialogue();
      }
    }, tweenFunction);
  }

  function startDialogue()
  {
    if (PlayState.instance.currentVariation == 'lyrics') PlayState.instance.startConversation('epiphany-lyrics');
    else if (!Save.instance.hasBeatenSong('epiphany', ['normal'])) PlayState.instance.startConversation('epiphany');
    else
      PlayState.instance.startConversation('epiphany-retry');
    PlayState.instance.currentConversation.completeCallback = fadeArrows;
  }

  function fadeArrows()
  {
    PlayState.instance.onConversationComplete();
    PlayState.instance.playerStrumline.fadeInArrows();
    PlayState.instance.opponentStrumline.fadeInArrows();
  }

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);
    hasPlayedCutscene = false;
  }

  function calcSectionLength(?duration:Int = 1)
  {
    var durSeconds = (Conductor.instance.stepLengthMs * (16 * duration)) / 1000;
    return durSeconds;
  }

  var lastBeat:Int = 0;
  
  function onBeatHit(event:SongTimeScriptEvent):Void
  {
    if (PlayState.instance?.isGameOverState ?? true) return;
    var currentStage:Stage = PlayState.instance.currentStage;

    if (lastBeat > event.step)
    {
      lastBeat = event.beat;
      return;
    }

    for (beat in lastBeat...event.beat)
    {
      switch (beat + 1)
      {
        case 585:
          FlxTween.tween(currentStage.dokiBackdrop, {alpha: 1}, calcSectionLength(), {ease: FlxEase.sineIn});
        case 648:
          FlxTween.tween(currentStage.dokiBackdrop, {alpha: 0.001}, calcSectionLength(0.5), {ease: FlxEase.sineOut});
          currentStage.popup.alpha = 1;
          currentStage.popup.animation.play('startDeleting');
          currentStage.popup.animation.curAnim.frameRate = 24 * PlayState.instance.playbackRate;
        case 788:
          var opponentStrumline:FunkinSprite = PlayState.instance.opponentStrumline;
          if (opponentStrumline != null)
          {
            for (arrow in opponentStrumline.members)
            {
              FlxTween.cancelTweensOf(arrow);
              FlxTween.tween(arrow, {alpha: 0}, calcSectionLength(0.25), {ease: FlxEase.sineOut});
            }
          }
          FlxTween.tween(PlayState.instance.iconP2, {alpha: 0}, calcSectionLength(0.25), {ease: FlxEase.sineOut});
        case 790:
          FlxTween.tween(currentStage.blackCover, {alpha: 1}, 0.7 * PlayState.instance.playbackRate);
      }  
    }
    lastBeat = event.beat;
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    hasPlayedCutscene = true;
  }
}
