import funkin.play.PlayState;
import funkin.play.song.Song;
import funkin.graphics.shaders.WiggleEffectRuntime;
import funkin.graphics.shaders.WiggleEffectType;
import flixel.addons.effects.FlxTrail;
import flixel.tweens.FlxTween;
import funkin.graphics.FunkinSprite;
import funkin.audio.FunkinSound;
import funkin.play.cutscene.dialogue.DialogueBox;
import funkin.play.PlayStatePlaylist;
import funkin.play.cutscene.dialogue.ConversationState;
import flixel.tweens.FlxEase;
import funkin.Conductor;
import funkin.modding.module.ModuleHandler;
// Countdown
import flixel.util.FlxTimer;
import funkin.play.Countdown;
import funkin.play.CountdownStep;
import funkin.util.EaseUtil;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.CountdownScriptEvent;

class YourDemiseSong extends Song
{
  var hasPlayedVideoCutscene:Bool;
  var hasPlayedIntroCutscene:Bool;
  var hasPlayedOutroCutscene:Bool;
  var blackScreen:FunkinSprite;
  var redStatic:FunkinSprite;

  function new()
  {
    super('your-demise');
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    redStatic = new FunkinSprite();
    redStatic.frames = Paths.getSparrowAtlas('gameplay/doki-general/home-static');
    redStatic.cameras = [PlayState.instance.camHUD];
    redStatic.animation.addByPrefix('idle', 'HomeStatic', 24, true);
    redStatic.animation.play('idle');
    redStatic.setGraphicSize(FlxG.width, FlxG.height);
    redStatic.screenCenter();
    redStatic.alpha = 0;
    PlayState.instance.add(redStatic);

    blackScreen = new FunkinSprite(-FlxG.width * FlxG.camera.zoom, -FlxG.height * FlxG.camera.zoom).makeGraphic(FlxG.width * 3, FlxG.height * 3, 0xFF000000);
    blackScreen.scrollFactor.set();
    blackScreen.alpha = 1;
    PlayState.instance.add(blackScreen);

    hasPlayedIntroCutscene = false;
    hasPlayedOutroCutscene = false;
  }

  function hideHud()
  {
    var opponentStrumline:FunkinSprite = PlayState.instance.opponentStrumline;
    var playerStrumline:FunkinSprite = PlayState.instance.playerStrumline;
    if (opponentStrumline != null)
    {
      for (arrow in opponentStrumline.strumlineNotes.members)
      {
        arrow.alpha = 0;
      }
    }
    if (playerStrumline != null)
    {
      for (arrow in playerStrumline.strumlineNotes.members)
      {
        arrow.alpha = 0;
      }
    }
    var hudElements:Array<Dynamic> = [PlayState.instance.healthBar, PlayState.instance.iconP1, PlayState.instance.iconP2, PlayState.instance.scoreText, PlayState.instance.healthBarBG];
    for (hud in hudElements)
    {
      hud.alpha = 0;
    }
  }

  function returnHud()
  {
    var opponentStrumline:FunkinSprite = PlayState.instance.opponentStrumline;
    var playerStrumline:FunkinSprite = PlayState.instance.playerStrumline;
    if (opponentStrumline != null)
    {
      for (arrow in opponentStrumline.strumlineNotes.members)
      {
        arrow.alpha = 1;
      }
    }
    if (playerStrumline != null)
    {
      for (arrow in playerStrumline.strumlineNotes.members)
      {
        arrow.alpha = 1;
      }
    }
    var hudElements:Array<Dynamic> = [PlayState.instance.healthBar, PlayState.instance.iconP1, PlayState.instance.iconP2, PlayState.instance.scoreText, PlayState.instance.healthBarBG];
    for (hud in hudElements)
    {
      FlxTween.tween(hud, {alpha: 1}, 1, {ease: FlxEase.quartOut});
    }
  }

  public function onCountdownStart(event):Void
  {
    super.onCountdownStart(event);
    PlayState.instance.currentStage.getGirlfriend().visible = false;
    if (!PlayStatePlaylist.isStoryMode) hasPlayedIntroCutscene = true;

    if (!PlayStatePlaylist.isStoryMode) blackScreen.alpha = 0;

    if (!hasPlayedIntroCutscene)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedIntroCutscene = true;

      hideHud();

      event.cancel(); // CANCEL THE COUNTDOWN!

      startDialogue();
    }
    else
    {
      FlxG.signals.postUpdate.addOnce(() ->
      {
        if (event.eventCanceled) return;
        YourDemiseCountdown.performCountdown();
      });
    }
  }

  /*public override function onSongEnd(event:CountdownScriptEvent):Void {
    super.onSongEnd(event);
    trace('Started countdown for Roses...');

    if (!PlayStatePlaylist.isStoryMode) hasPlayedOutroCutscene = true;

    if (!hasPlayedOutroCutscene) {
      trace('Pausing countdown to play cutscene.');

      hasPlayedOutroCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camCutscene.visible = true;

      startEndDialogue();
    }	
  }*/
  function stageSwap(swap:Bool)
  {
    glitchEffect();
    if (swap)
    {
      PlayState.instance.currentStage.getBoyfriend().x = 1000;
      PlayState.instance.currentStage.getBoyfriend().y = 550;
      PlayState.instance.currentStage.getNamedProp('finaleSpace').alpha = 1;
      PlayState.instance.currentStage.getNamedProp('finaleBG').alpha = 1;
      PlayState.instance.currentStage.getNamedProp('finaleFG').alpha = 1;
    }
    else
    {
      PlayState.instance.currentStage.getBoyfriend().resetPosition();
      PlayState.instance.currentStage.getNamedProp('finaleSpace').alpha = 0;
      PlayState.instance.currentStage.getNamedProp('finaleBG').alpha = 0;
      PlayState.instance.currentStage.getNamedProp('finaleFG').alpha = 0;
    }
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    PlayState.instance.currentStage.getGirlfriend().visible = false; // Actually hide GF now
    redStatic.alpha = 0;
    if (PlayStatePlaylist.isStoryMode) blackScreen.alpha = 1;
    else
      blackScreen.alpha = 0;
    PlayState.instance.currentStage.getNamedProp('finaleSpace').alpha = 0;
    PlayState.instance.currentStage.getNamedProp('finaleBG').alpha = 0;
    PlayState.instance.currentStage.getNamedProp('finaleFG').alpha = 0;
  }

  function glitchEffect()
  {
    FlxTween.cancelTweensOf(redStatic);
    redStatic.alpha = 1;
    FlxTween.tween(redStatic, {alpha: 0}, 0.2, {ease: FlxEase.linear});
  }

  function startDialogue()
  {
    PlayState.instance.startConversation('your-demise');
    PlayState.instance.currentConversation.completeCallback = songStart;
  }

  function startEndDialogue()
  {
    PlayState.instance.startConversation('your-demise-end');
    PlayState.instance.currentConversation.completeCallback = endSong;
  }

  function songStart()
  {
    PlayState.instance.onConversationComplete();
    returnHud();
    PlayState.instance.playerStrumline.fadeInArrows();
    PlayState.instance.opponentStrumline.fadeInArrows();
  }

  function endSong()
  {
    PlayState.instance.endSong();
  }

  var lastStep:Int = 0;

  function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance?.isGameOverState ?? true) return;

    if (lastStep > event.step)
    {
      lastStep = event.step;
      return;
    }

    for (step in lastStep...event.step)
    {
      switch (step + 1)
      {
        case 0:
          if (PlayStatePlaylist.isStoryMode) FlxTween.tween(blackScreen, {alpha: 0}, 0.5);
        case 264:
          blackScreen.alpha = 1;
        case 328:
          stageSwap(true);
          ModuleHandler.getModule('Credits').manualCreditsSummon();
          blackScreen.alpha = 0;
        case 840:
          stageSwap(false);
        case 1640:
          stageSwap(true);
        case 1864:
          FlxTween.tween(blackScreen, {alpha: 1}, 0.5);
      }
    }
    lastStep = event.step;
  }
}

// Custom class to handle the countdown cuz fuck making a new notestyle
class YourDemiseCountdown
{
  var countdownStep:CountdownStep;

  public static function performCountdown():Bool
  {
    countdownStep = CountdownStep.BEFORE;

    Countdown.stopCountdown();

    PlayState.instance.isInCountdown = true;
    Conductor.instance.update(PlayState.instance.startTimestamp + Conductor.instance.beatLengthMs * -5);

    // The timer function gets called based on the beat of the song.
    Countdown.countdownTimer = new FlxTimer();

    Countdown.countdownTimer.start(Conductor.instance.beatLengthMs / 1000, function(tmr:FlxTimer)
    {
      if (PlayState.instance == null)
      {
        tmr.cancel();
        return;
      }

      countdownStep = decrement(countdownStep);
      var countdownStepInt:Int = tmr.loopsLeft - 1;

      // onBeatHit events are now properly dispatched by the Conductor even at negative timestamps,
      // so calling this is no longer necessary.
      // PlayState.instance.dispatchEvent(new SongTimeScriptEvent(SONG_BEAT_HIT, 0, 0));

      // Countdown graphic.
      showCountdownGraphic(countdownStepInt);

      // Countdown sound.
      playCountdownSound(countdownStepInt);

      // Event handling bullshit.
      var cancelled:Bool = propagateCountdownEvent(countdownStep);

      if (cancelled)
      {
        Countdown.pauseCountdown();
      }

      if (countdownStep == CountdownStep.AFTER)
      {
        Countdown.stopCountdown();
      }
    }, 5); // Before, 3, 2, 1, GO!, After

    return true;
  }

  public static function playCountdownSound(index:Int):Void
  {
    var soundPath:String = switch (index)
    {
      case 3, 2, 1: 'gameplay/notestyles/ddtopixel/countdown/sounds-glitch/intro$index-glitch';
      case 0: 'gameplay/notestyles/ddtopixel/countdown/sounds-glitch/introGo-glitch';
      default: null;
    }

    if (soundPath == null) return;

    FunkinSound.playOnce(Paths.sound(soundPath), Constants.COUNTDOWN_VOLUME);
  }

  public static function showCountdownGraphic(index:Int):Void
  {
    var assetPath:Null<String> = switch (index)
    {
      case 2: 'gameplay/notestyles/ddtopixel/countdown/graphics-glitch/ready';
      case 1: 'gameplay/notestyles/ddtopixel/countdown/graphics-glitch/set';
      case 0: 'gameplay/notestyles/ddtopixel/countdown/graphics-glitch/demise';
      default: null;
    }
    if (assetPath == null) return;

    var countdownSprite:FunkinSprite = new FunkinSprite();
    countdownSprite.loadTexture(assetPath);
    countdownSprite.scale.x = 6;
    countdownSprite.scale.y = 6;
    countdownSprite.scrollFactor.set(0, 0);
    countdownSprite.antialiasing = false;
    countdownSprite.updateHitbox();

    var fadeEase = EaseUtil.stepped(8);

    // Fade sprite in, then out, then destroy it.
    FlxTween.tween(countdownSprite, {alpha: 0}, Conductor.instance.beatLengthMs / 1000, {
      ease: fadeEase,
      onComplete: function(twn:FlxTween)
      {
        countdownSprite.destroy();
      }
    });

    countdownSprite.cameras = [PlayState.instance.camHUD];
    PlayState.instance.add(countdownSprite);
    countdownSprite.screenCenter();
  }

  public static function decrement(step:CountdownStep):CountdownStep
  {
    switch (step)
    {
      case CountdownStep.BEFORE:
        return CountdownStep.THREE;
      case CountdownStep.THREE:
        return CountdownStep.TWO;
      case CountdownStep.TWO:
        return CountdownStep.ONE;
      case CountdownStep.ONE:
        return CountdownStep.GO;
      case CountdownStep.GO:
        return CountdownStep.AFTER;
      default:
        return CountdownStep.AFTER;
    }
  }

  static function propagateCountdownEvent(index:CountdownStep):Bool
  {
    var event:ScriptEvent;

    switch (index)
    {
      case CountdownStep.BEFORE:
        event = new CountdownScriptEvent('COUNTDOWN_START', index);
      case CountdownStep.THREE, CountdownStep.TWO, CountdownStep.ONE, CountdownStep.GO: // I didn't know you could use `|` in a switch/case block!
        event = new CountdownScriptEvent('COUNTDOWN_STEP', index);
      case CountdownStep.AFTER:
        event = new CountdownScriptEvent('COUNTDOWN_END', index, false);
      default:
        return true;
    }

    // Modules, stages, characters.
    PlayState.instance.dispatchEvent(event);

    return event.eventCanceled;
  }
}
