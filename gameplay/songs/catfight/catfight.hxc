import funkin.play.PlayState;
import flixel.tweens.FlxTween;
import funkin.graphics.FunkinSprite;
import flixel.util.FlxTimer;
import funkin.audio.FunkinSound;
import flixel.tweens.FlxEase;
import funkin.play.song.Song;
import funkin.play.Countdown;
import funkin.Conductor;
import funkin.util.FlxTweenUtil;
import funkin.graphics.FunkinBackdrop;
import flixel.FlxCamera;
import funkin.Highscore;
import funkin.play.character.CharacterType;
import funkin.play.components.HealthIcon;
import flixel.math.FlxMath;
import funkin.PlayerSettings;
import funkin.save.Save;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.Module;
import funkin.mobile.input.ControlsHandler;
import funkin.modding.ModStore;
import funkin.ui.FullScreenScaleMode;
import ddto.cutscene.DokiConversationSystem;
import ddto.gameplay.MirrorModeHealthIcon;

using funkin.data.song.SongDataUtils;
using funkin.util.tools.ArrayTools;

class CatfightSong extends Song
{
  function new()
  {
    super('catfight');
  }

  var psychMod:Module;

  var strumlineNames = ['playerStrumline', 'opponentStrumline'];
  var hasPlayedIntroCutscene:Bool;
  var hasPlayedOutroCutscene:Bool;
  var defaultCamPos:Null<Float>;
  var isYuri(get, never):Bool;
  var shownPopup:Bool;

  function get_isYuri():Bool
  {
    return ModStore.get('catfightIsYuri') ?? false;
  }

  var currentStage(get, never):Stage;

  function get_currentStage():Stage
  {
    return PlayState.instance?.currentStage;
  }

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);
    hasPlayedIntroCutscene = hasPlayedOutroCutscene = false;
    choseDoki();

    defaultCamPos = null;

    shownPopup = false;

    // Use a custom health icon to force the icons to swap directions
    if (!isYuri) return;
    PlayState.instance.healthBar.flipX = true;
    PlayState.instance.healthBarBG.flipX = true;

    PlayState.instance.iconP2.destroy();
    PlayState.instance.iconP2 = new MirrorModeHealthIcon('dad', 1);
    PlayState.instance.iconP2.y = PlayState.instance.healthBar.y - (PlayState.instance.iconP2.height / 2);
    PlayState.instance.iconP2.zIndex = 850;
    PlayState.instance.add(PlayState.instance.iconP2);
    PlayState.instance.iconP2.cameras = [PlayState.instance.camHUD];
    PlayState.instance.currentStage.getDad()?.initHealthIcon(true);

    PlayState.instance.iconP1.destroy();
    PlayState.instance.iconP1 = new MirrorModeHealthIcon('bf', 0);
    PlayState.instance.iconP1.y = PlayState.instance.healthBar.y - (PlayState.instance.iconP1.height / 2);
    PlayState.instance.iconP1.zIndex = 850;
    PlayState.instance.add(PlayState.instance.iconP1);
    PlayState.instance.iconP1.cameras = [PlayState.instance.camHUD];
    PlayState.instance.currentStage.getBoyfriend()?.initHealthIcon(false);
  }

  public function onCountdownStart(event):Void
  {
    super.onCountdownStart(event);
    if (PlayState.instance?.currentStage == null || PlayState.instance.isMinimalMode) return;

    if (PlayState.instance.isChartingMode) hasPlayedIntroCutscene = hasPlayedOutroCutscene = true;

    currentStage.getGirlfriend().idleSuffix = '-alt';

    if (isYuri)
    {
      // psychMod.active = false;
      currentStage.getDad().characterType = CharacterType.BF;
      currentStage.getBoyfriend().characterType = CharacterType.DAD;
    }

    if (!hasPlayedIntroCutscene && DokiPreferences.freeplayDialogue)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedIntroCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camHUD.visible = false;

      startIntroDialogue();
      return;
    }

    PlayState.instance.playerStrumline.resetScrollSpeed();
    PlayState.instance.opponentStrumline.resetScrollSpeed();

    if (!shownPopup)
    {
      var who:String = (isYuri ? 'catfightYuriPopup' : 'catfightNatPopup');
      var anim:String = (isYuri ? 'PopUpYuri' : 'PopUpNatsuki');
      var catpopup:FunkinSprite = new FunkinSprite(400, 400);
      catpopup.frames = Paths.getSparrowAtlas('gameplay/songs/catfight/graphics/' + who);
      catpopup.animation.addByPrefix('idle', anim, 24, false);
      catpopup.setGraphicSize(Std.int(catpopup.width * 0.7));
      catpopup.updateHitbox();
      catpopup.animation.play('idle');
      PlayState.instance.add(catpopup);
    }

    if (defaultCamPos == null) defaultCamPos = currentStage.getBoyfriend().cameraFocusPoint.y;

    if (currentStage.getBoyfriend().cameraFocusPoint.y == defaultCamPos) currentStage.getBoyfriend().cameraFocusPoint.y += 125;
  }

  function startIntroDialogue()
  {
    DokiConversationSystem.startConversation(this.id);
  }

  function startOutroDialogue()
  {
    DokiConversationSystem.startConversation(this.id, 'End');
    DokiConversationSystem.dialogueBox.completeCallback = function()
    {
      DokiConversationSystem.onConversationComplete();
      PlayState.instance.endSong();
    };
  }

  override public function onSongEnd(event)
  {
    super.onSongEnd(event);
    if (!hasPlayedOutroCutscene && DokiPreferences.freeplayDialogue)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedOutroCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camHUD.visible = false;

      startOutroDialogue();
    }
  }

  override public function onSongLoaded(event)
  {
    super.onSongLoaded(event);
    var ps:PlayState = PlayState.instance;
    // I fucking HATE V-Slice
    var notes:Array<SongNoteData> = PlayState.instance.currentSong.getDifficulty(ps.currentDifficulty, ps.currentVariation).notes.deepClone();
    if (isYuri) notes = notes.flipNotes();
    for (songNote in notes)
    {
      var noteData:Int = songNote.data;

      if (songNote.getStrumlineIndex() == 0 && songNote.kind == 'gf')
      {
        notes.remove(songNote);
      }
    }
    event.notes = notes.copy();
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    if (!isYuri) return;
    FlxG.signals.postUpdate.addOnce(() ->
    {
      swapCharacters();
    });
  }

  function swapCharacters():Void
  {
    currentStage.getDad().characterType = CharacterType.BF;
    currentStage.getBoyfriend().characterType = CharacterType.DAD;
    final cutoutSize = FullScreenScaleMode.gameCutoutSize.x / 2.5;
    #if mobile
    if (ControlsHandler.usingExternalInputDevice)
    {
      PlayState.instance.playerStrumline.x = Constants.STRUMLINE_X_OFFSET + cutoutSize;
      PlayState.instance.opponentStrumline.x = (FlxG.width / 2 + Constants.STRUMLINE_X_OFFSET);
    }
    #else
    PlayState.instance.playerStrumline.x = Constants.STRUMLINE_X_OFFSET + cutoutSize;
    PlayState.instance.opponentStrumline.x = (FlxG.width / 2 + Constants.STRUMLINE_X_OFFSET);
    #end
  }

  function choseDoki()
  {
    FlxG.signals.postUpdate.addOnce(() -> {
      if (!isYuri) return;
      var playerVocals = PlayState.instance.vocals.playerVoices.members[0];
      PlayState.instance.vocals.playerVoices.members[0] = PlayState.instance.vocals.opponentVoices.members[0];
      PlayState.instance.vocals.opponentVoices.members[0] = playerVocals;
      swapCharacters();
    });
  }

  function calcSectionLength(?duration:Int = 1)
  {
    var durSeconds = (Conductor.instance.stepLengthMs * (16 * duration)) / 1000;
    return durSeconds;
  }

  var lastStep:Int = 0;

  function onStepHit(event:SongTimeScriptEvent):Void
  {
    if (PlayState.instance.isGameOverState) return;

    if (event.step > lastStep)
    {
      for (i in lastStep...event.step)
      {
        switch (i + 1)
        {
          case 608:
            PlayState.instance.tweenCameraZoom(0.8, calcSectionLength(1), true, FlxEase.expoOut);
          case 624:
            PlayState.instance.tweenCameraZoom(0.85, calcSectionLength(1), true, FlxEase.expoOut);
          case 640:
            PlayState.instance.tweenScrollSpeed(PlayState.instance.playerStrumline.scrollSpeed + 0.1, calcSectionLength(1), FlxEase.expoOut, strumlineNames);
            PlayState.instance.tweenCameraZoom(0.9, calcSectionLength(1), true, FlxEase.expoOut);
          case 1120:
            PlayState.instance.tweenCameraZoom(0.95, calcSectionLength(1), true, FlxEase.expoOut);
          case 1136:
            PlayState.instance.tweenScrollSpeed(PlayState.instance.playerStrumline.scrollSpeed + 0.1, calcSectionLength(1), FlxEase.expoOut, strumlineNames);

            PlayState.instance.tweenCameraZoom(1, calcSectionLength(1), true, FlxEase.expoOut);
          case 1150:
            PlayState.instance.cameraFollowPoint.setPosition(currentStage.getGirlfriend().cameraFocusPoint.x, currentStage.getGirlfriend().cameraFocusPoint.y - 125);
            PlayState.instance.tweenCameraZoom(1.6, calcSectionLength(1), true, FlxEase.expoOut);
          case 1169:
            PlayState.instance.tweenCameraZoom(1.05, calcSectionLength(1), true, FlxEase.expoOut);
          case 1568:
            PlayState.instance.tweenScrollSpeed(PlayState.instance.playerStrumline.scrollSpeed + 0.05, calcSectionLength(1), FlxEase.expoOut, strumlineNames);

            PlayState.instance.tweenCameraZoom(1.1, calcSectionLength(1), true, FlxEase.expoOut);
          case 1696:
            PlayState.instance.tweenScrollSpeed(PlayState.instance.playerStrumline.scrollSpeed + 0.05, calcSectionLength(1), FlxEase.expoOut, strumlineNames);

            PlayState.instance.tweenCameraZoom(1.15, calcSectionLength(1), true, FlxEase.expoOut);
          case 1824:
            PlayState.instance.tweenScrollSpeed(PlayState.instance.playerStrumline.scrollSpeed + 0.05, calcSectionLength(1), FlxEase.expoOut, strumlineNames);

            PlayState.instance.tweenCameraZoom(1.2, calcSectionLength(1), true, FlxEase.expoOut);
        }
      }
    }
    lastStep = event.step;
  }
}
