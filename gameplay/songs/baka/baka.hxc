import funkin.play.PlayState;
import flixel.tweens.FlxTween;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxEase;
import funkin.play.song.Song;
import funkin.play.Countdown;
import funkin.Conductor;
import funkin.play.PlayStatePlaylist;
import ddto.cutscene.DokiConversationSystem;

class BakaSong extends Song
{
  function new()
  {
    super('baka');
  }

  var bakaOverlay:FunkinSprite;
  var hasPlayedIntroCutscene:Bool;
  var hasPlayedOutroCutscene:Bool;
  var backupShake;

  /*public override function listAltInstrumentalIds(difficultyId:String, variationId:String):Array<String> {
    switch (variationId) {
      case 'alt':
        return [""];
        default:
        return ['alt'];
    }  
  }*/
  override function onCreate(event)
  {
    super.onCreate(event);
    if (PlayState.instance?.currentStage == null || PlayState.instance.isMinimalMode) return;

    hasPlayedIntroCutscene = hasPlayedOutroCutscene = false;

    bakaOverlay = new FunkinSprite(0, 0);
    bakaOverlay.frames = Paths.getSparrowAtlas('gameplay/songs/baka/graphics/baka-bg-doodles');
    bakaOverlay.animation.addByPrefix('normal', 'Normal Overlay', 24, true);
    bakaOverlay.animation.addByPrefix('party rock is', 'Rock Overlay', 24, true);
    bakaOverlay.animation.addByPrefix('FUCK', 'Tank Overlay', 24, true);
    bakaOverlay.animation.play('normal');
    bakaOverlay.scrollFactor.set();
    bakaOverlay.zIndex = 400;
    bakaOverlay.alpha = 0;
    bakaOverlay.cameras = [PlayState.instance.camHUD];
    bakaOverlay.setGraphicSize(Std.int(FlxG.width));
    bakaOverlay.updateHitbox();
    bakaOverlay.screenCenter();
    PlayState.instance.add(bakaOverlay);
  }

  function calcSectionLength(?duration:Int = 1)
  {
    var durSeconds = (Conductor.instance.stepLengthMs * (16 * duration)) / 1000;
    return durSeconds;
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);

    hasPlayedIntroCutscene = true;
    FlxTween.cancelTweensOf(bakaOverlay);
    FlxTween.tween(bakaOverlay, {alpha: 0}, 0.5, {ease: FlxEase.sineOut, onComplete: _ -> bakaOverlay.animation.play('normal')});
  }

  function startDialogue()
  {
    DokiConversationSystem.startConversation('${this.id}');
  }

  override function onPause(event)
  {
    super.onPause(event);
    if (FlxG.camera._fxShakeDuration > 0)
    {
      backupShake = FlxG.camera._fxShakeDuration;
      FlxG.camera._fxShakeDuration = 0;
    }
  }

  override function onResume(event)
  {
    super.onResume(event);
    if (backupShake != null)
    {
      FlxG.camera._fxShakeDuration = backupShake;
      backupShake = null;
    }
  }

  var lastStep:Int = 0;

  function onStepHit(event:SongTimeScriptEvent):Void
  {
    if ((PlayState.instance?.isGameOverState ?? true)) return;

    if (lastStep > event.step)
    {
      lastStep = event.step;
      return;
    }

    for (step in lastStep...event.step)
    {
      switch (step + 1)
      {
        case 64:
          FlxTween.tween(bakaOverlay, {alpha: 1}, calcSectionLength(2), {ease: FlxEase.sineOut});
        case 128:
          if (PlayState.instance.currentVariation != 'alt') PlayState.instance.camGame.shake(0.002, calcSectionLength(2));
          if (bakaOverlay.alpha != 1) FlxTween.tween(bakaOverlay, {alpha: 1}, calcSectionLength(1), {ease: FlxEase.sineOut});
          if (PlayState.instance.currentVariation == 'alt')
          {
            bakaOverlay.animation.play('FUCK');
            PlayState.instance.camHUD.flash(0xFFFDC1FF, calcSectionLength(0.2));
          }
          else
            bakaOverlay.animation.play('party rock is');
        case 448:
          FlxTween.tween(bakaOverlay, {alpha: 0}, calcSectionLength(2), {ease: FlxEase.sineOut});
        case 576:
          bakaOverlay.animation.play('normal');
          FlxTween.tween(bakaOverlay, {alpha: 1}, calcSectionLength(2), {ease: FlxEase.sineOut});
        case 704:
          if (bakaOverlay.alpha != 1) FlxTween.tween(bakaOverlay, {alpha: 1}, calcSectionLength(1), {ease: FlxEase.sineOut});
          if (PlayState.instance.currentVariation == 'alt')
          {
            bakaOverlay.animation.play('FUCK');
            PlayState.instance.camHUD.flash(0xFFFDC1FF, calcSectionLength(0.2));
          }
          else
            bakaOverlay.animation.play('party rock is');
      }
    }
    lastStep = event.step;
  }

  public override function onSongEnd(event:CountdownScriptEvent):Void
  {
    super.onSongEnd(event);
    if (!PlayStatePlaylist.isStoryMode) hasPlayedOutroCutscene = true;

    if (!hasPlayedOutroCutscene)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedOutroCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camCutscene.visible = true;

      PlayState.instance.camCutscene.fade(null, 2, false, () -> {
        PlayState.instance.camCutscene.fade(null, 2, true);
        PlayState.instance.camHUD.visible = false;
        var imageBG:FunkinSprite = new FunkinSprite(0, 0);
        imageBG.loadGraphic(Paths.image('gameplay/dialogue/doki-conversations/bgs/ending2'));
        imageBG.antialiasing = false;
        imageBG.scrollFactor.set();
        imageBG.cameras = [PlayState.instance.camCutscene];
        imageBG.updateHitbox();
        imageBG.screenCenter();
        PlayState.instance.add(imageBG);
        startEndDialogue();
      });
    }
  }
  
  function startEndDialogue()
  {
    DokiConversationSystem.startConversation('${this.id}', 'End');
    DokiConversationSystem.dialogueBox.completeCallback = () -> {
      DokiConversationSystem.onConversationComplete();
      PlayState.instance.endSong();
    }
  }

  public function onCountdownStart(event):Void
  {
    super.onCountdownStart(event);
    if (!PlayStatePlaylist.isStoryMode) hasPlayedIntroCutscene = true;
    if (!hasPlayedIntroCutscene)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedIntroCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      startDialogue();
    }
  }
}
