import funkin.play.PlayState;
import flixel.tweens.FlxTween;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxEase;
import funkin.play.song.Song;
import funkin.Conductor;
import funkin.util.FlxTweenUtil;
import funkin.play.character.CharacterDataParser;
import funkin.play.character.CharacterType;
import funkin.save.Save;
import funkin.modding.module.Module;
import funkin.graphics.FunkinCamera;
import funkin.modding.module.Module;
import funkin.ui.FullScreenScaleMode;
import StringTools;

class LoveNFunkinSong extends Song
{
  function new()
  {
    super('love-n-funkin');

    options = DokiPreferences.getDokiSave();
  }

  var yuri:BaseCharacter;
  var natsuki:BaseCharacter;
  var monika:BaseCharacter;
  var dokiData:Array<Float> = [];
  var sideWindow:FunkinSprite;
  var camGame2:FunkinCamera;
  var savedChar:String;
  var poemVideo:FunkinSprite;
  
  var currentStage(get, never):Stage;

  function get_currentStage():Stage
  {
    return PlayState.instance?.currentStage;
  }

  final STAGE_PATH:String = 'gameplay/stages/musicroom';

  public override function isSongNew(currentDifficulty:String):Bool
  {
    if (!Save.instance.hasBeatenSong(this.id)) return true;
    else
      return false;
  }

  override function onCreate(event)
  {
    super.onCreate(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;

    camGame2 = new FunkinCamera('playStateCamGame2');
    FlxG.cameras.insert(camGame2, FlxG.cameras.list.indexOf(PlayState.instance.camHUD), false);
    camGame2.bgColor = 0x000000;

    var poemSprite:String = '$STAGE_PATH/love-n-funkin/';
    if (PlayState.instance.currentVariation == 'pico') poemSprite += 'poem-pico';
    else poemSprite += 'poem-gf';
    poemVideo = FunkinSprite.createTextureAtlas(0, 0, poemSprite, {applyStageMatrix: true});
    if (PlayState.instance.currentVariation == 'pico') poemVideo.anim.addBySymbol('hando', 'lnf video Pico');
    else poemVideo.anim.addBySymbol('hando', 'lnf video');
    poemVideo.anim.play('hando');
    poemVideo.scrollFactor.set();
    poemVideo.setGraphicSize(Std.int(poemVideo.width / PlayState.instance.stageZoom));
    poemVideo.updateHitbox();
    poemVideo.cameras = [camGame2];
    poemVideo.alpha = 0.001;
    PlayState.instance.add(poemVideo);

    sideWindow = new FunkinSprite(0, 0, Paths.image('$STAGE_PATH/love-n-funkin/side-window'));
    sideWindow.setGraphicSize(Std.int(sideWindow.width / PlayState.instance.stageZoom));
    sideWindow.updateHitbox();
    sideWindow.y = FlxG.height - sideWindow.height;
    sideWindow.scrollFactor.set(0, 0);
    sideWindow.cameras = [camGame2];
    sideWindow.alpha = 0.001;
    PlayState.instance.add(sideWindow);

    savedChar = ''; // Used so we can reset the character if they are on the side

    yuri = addExtraCharacter('yuri', 'dad', {offsets: [200, -20], zIndex: currentStage._data.characters.dad.zIndex - 1});
    natsuki = addExtraCharacter('natsuki', 'dad', {offsets: [-200, 20], zIndex: currentStage._data.characters.dad.zIndex + 1});
    monika = addExtraCharacter('monika', 'dad', {offsets: [450, -20], zIndex: currentStage._data.characters.dad.zIndex - 2});

    currentStage.refresh();

    PlayState.instance.iconP2.configure({id: 'love-n-funkin'});
  }

  function onNoteHit(callback)
  {
    if (PlayState.instance == null) return;

    switch (callback.note.noteData.kind)
    {
      case "GF Sing":
        yuri.holdTimer = 0;
        yuri.playSingAnimation(callback.note.noteData.getDirection(), false);
      case "Hurt Note":
        natsuki.holdTimer = 0;
        natsuki.playSingAnimation(callback.note.noteData.getDirection(), false);
      case "Monika":
        monika.holdTimer = 0;
        monika.playSingAnimation(callback.note.noteData.getDirection(), false);
    }
  }

  override function onUpdate(event:UpdateScriptEvent)
  {
    super.onUpdate(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;

    if (camGame2 != null) camGame2.zoom = FlxG.camera.zoom;
    processNotes(event);
  }

  function stutterNotes(elapsed:Float):Void
  {
    // Process hold notes on the opponent's side.
    for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members)
    {
      if (holdNote == null || !holdNote.alive) continue;

      // While the hold note is being hit, and there is length on the hold note...
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0)
      {
        switch (holdNote.noteData.kind)
        {
          case "GF Sing":
            if (yuri.isSinging()) yuri.animation.curAnim.restart();
          case "Hurt Note":
            if (natsuki.isSinging()) natsuki.animation.curAnim.restart();
          case "Monika":
            if (monika.isSinging()) monika.animation.curAnim.restart();
        }
      }
    }
  }

  function processNotes(elapsed:Float):Void
  {
    // Process hold notes on the opponent's side.
    for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members)
    {
      if (holdNote == null || !holdNote.alive) continue;

      // While the hold note is being hit, and there is length on the hold note...
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0)
      {
        switch (holdNote.noteData.kind)
        {
          case "GF Sing":
            if (yuri.isSinging()) yuri.holdTimer = 0;
          case "Hurt Note":
            if (natsuki.isSinging()) natsuki.holdTimer = 0;
          case "Monika":
            if (monika.isSinging()) monika.holdTimer = 0;
        }
      }
    }
  }

  override function onSongEnd(event)
  {
    super.onSongEnd(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;
  }

  function addExtraCharacter(name:String, basedOn:String, data:Dynamic)
  {
    var stageCharData:StageDataCharacter = switch (basedOn)
    {
      case 'dad': currentStage._data.characters.dad;
      case 'bf': currentStage._data.characters.bf;
      case 'gf': currentStage._data.characters.gf;
    }
    var character:BaseCharacter = CharacterDataParser.fetchCharacter(name);
    currentStage.addCharacter(character, CharacterType.OTHER);
    character.zIndex = data.zIndex ?? stageCharData.zIndex;
    character.x = (stageCharData.position[0] - character.characterOrigin.x) + (data.offsets[0] ?? 0);
    character.y = (stageCharData.position[1] - character.characterOrigin.y) + (data.offsets[1] ?? 0);

    character.originalPosition.set(character.x, character.y);
    
    return character;
  }

  override function onCountdownStart(event)
  {
    super.onCountdownStart(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;

    PlayState.instance.iconP2.loadCharacter('love-n-funkin');
  }

  function calcSectionLength(?duration:Int = 1)
  {
    if (duration == null) duration = 1;
    var durSeconds = (Conductor.instance.stepLengthMs * (16 * duration)) / 1000;
    return durSeconds;
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    sideWindow.alpha = 0.001;
    poemVideo.alpha = 0.001;
    switch (savedChar)
    {
      case 'monika':
        FlxTween.cancelTweensOf(monika);
        PlayState.instance.remove(monika);
        currentStage.insert(Std.int(dokiData[6]), monika);
        monika.setPosition(dokiData[0], dokiData[1]);
        monika.scrollFactor.set(dokiData[2], dokiData[3]);
        monika.scale.set(dokiData[4], dokiData[5]);
        monika.updateHitbox();
        monika.cameras = [PlayState.instance.camGame];
        monika.dance();
      case 'yuri':
        FlxTween.cancelTweensOf(yuri);
        PlayState.instance.remove(yuri);
        currentStage.insert(Std.int(dokiData[6]), yuri);
        yuri.setPosition(dokiData[0], dokiData[1]);
        yuri.scrollFactor.set(dokiData[2], dokiData[3]);
        yuri.scale.set(dokiData[4], dokiData[5]);
        yuri.updateHitbox();
        yuri.cameras = [PlayState.instance.camGame];
        yuri.dance();
    }
    PlayState.instance.cameraZoomRate = 4;
    FlxG.signals.postUpdate.addOnce(() -> {
      PlayState.instance.iconP2.configure({id: 'love-n-funkin'});
    });
  }

  function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;
    if (options.psychholds) stutterNotes();

    switch (event.step)
    {
      case 384:
        savedChar = 'yuri';
        dokiData = [yuri.x, yuri.y, yuri.scrollFactor.x, yuri.scrollFactor.y, yuri.scale.x, yuri.scale.y, currentStage.members.indexOf(yuri)];

        currentStage.remove(yuri);
        PlayState.instance.insert(PlayState.instance.members.indexOf(sideWindow) + 1, yuri);
        yuri.setPosition(6, 200);
        yuri.scrollFactor.set();
        yuri.scale.set(0.8, 0.8);
        yuri.updateHitbox();
        yuri.cameras = [camGame2];
        yuri.dance();

        PlayState.instance.currentCameraZoom = 1;
        camGame2.fade(0xFFFFFFFF, 0.5, true);
        poemVideo.anim.play('hando', true);
        poemVideo.alpha = 1;
        sideWindow.alpha = 1;
      case 504:
        FlxTween.tween(yuri, {x: -yuri.width * 1.5}, calcSectionLength(0.25), {ease: FlxEase.sineInOut});
      case 508:
        FlxTween.cancelTweensOf(yuri);
        PlayState.instance.remove(yuri);
        currentStage.insert(Std.int(dokiData[6]), yuri);
        yuri.setPosition(dokiData[0], dokiData[1]);
        yuri.scrollFactor.set(dokiData[2], dokiData[3]);
        yuri.scale.set(dokiData[4], dokiData[5]);
        yuri.updateHitbox();
        yuri.cameras = [PlayState.instance.camGame];
        yuri.dance();

        savedChar = 'monika';
        dokiData = [monika.x, monika.y, monika.scrollFactor.x, monika.scrollFactor.y, monika.scale.x, monika.scale.y, currentStage.members.indexOf(monika)];

        currentStage.remove(monika);
        PlayState.instance.insert(PlayState.instance.members.indexOf(sideWindow) + 1, monika);
        monika.setPosition(-monika.width * 1.5, 275);
        monika.scrollFactor.set();
        monika.scale.set(0.72, 0.72);
        monika.updateHitbox();
        monika.cameras = [camGame2];
        monika.dance();
        FlxTween.tween(monika, {x: 0}, calcSectionLength(0.25), {ease: FlxEase.sineInOut});
      case 640:
        PlayState.instance.remove(monika);
        currentStage.insert(Std.int(dokiData[6]), monika);
        monika.setPosition(dokiData[0], dokiData[1]);
        monika.scrollFactor.set(dokiData[2], dokiData[3]);
        monika.scale.set(dokiData[4], dokiData[5]);
        monika.updateHitbox();
        monika.cameras = [PlayState.instance.camGame];
        monika.dance();

        savedChar = '';
        camGame2.fade(0xFFFFFFFF, 0.5, true);
        poemVideo.alpha = 0.001;
        sideWindow.alpha = 0.001;
    }
  }
}
