import funkin.play.PlayState;
import flixel.tweens.FlxTween;
import funkin.graphics.FunkinSprite;
import funkin.audio.FunkinSound;
import funkin.play.song.Song;
import funkin.Conductor;
import funkin.util.FlxTweenUtil;
import funkin.play.PlayStatePlaylist;
import flixel.util.FlxColor;
import ddto.cutscene.DokiConversationSystem;

class NeetSong extends Song
{
  function new()
  {
    super('neet');
  }

  var spotlight:FunkinSprite;

  var sayori:FunkinSprite;
  var natsuki:FunkinSprite;
  var yuri:FunkinSprite;
  var monika:FunkinSprite;
  var protag:FunkinSprite;
  var deskfront:FunkinSprite;
  var blackScreenBG:FunkinSprite;

  var hasPlayedIntroCutscene:Bool;
  var hasPlayedOutroCutscene:Bool;

  override function onCreate(event)
  {
    super.onCreate(event);
    if (PlayState.instance?.currentStage == null || PlayState.instance.isMinimalMode) return;

    var stage = PlayState.instance.currentStage;

    blackScreenBG = new FunkinSprite(-FlxG.width * FlxG.camera.zoom,
      -FlxG.height * FlxG.camera.zoom).makeSolidColor(FlxG.width * 3, FlxG.height * 3, FlxColor.BLACK);
    blackScreenBG.alpha = 0.0001;
    blackScreenBG.zIndex = 54;
    blackScreenBG.scrollFactor.set();
    PlayState.instance.currentStage.add(blackScreenBG);

    spotlight = new FunkinSprite(-700, -520).loadGraphic(Paths.image('gameplay/songs/neet/spotlight-neet'));
    spotlight.setGraphicSize(Std.int(spotlight.width * 1.6));
    spotlight.alpha = 0.001;
    spotlight.blend = 12;
    spotlight.zIndex = 55;
    spotlight.updateHitbox();
    PlayState.instance.currentStage.add(spotlight);
    PlayState.instance.currentStage.refresh();

    sayori = stage.getNamedProp('BG Sayori');
    natsuki = stage.getNamedProp('BG Natsuki');
    yuri = stage.getNamedProp('BG Yuri');
    monika = stage.getNamedProp('BG Monika');
    protag = stage.getNamedProp('BG Protag');
    deskfront = stage.getNamedProp('Front Desks');
  }

  function calcSectionLength(?duration:Int = 1)
  {
    var durSeconds = (Conductor.instance.stepLengthMs * (16 * (duration ?? 1))) / 1000;
    return durSeconds;
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);

    hasPlayedIntroCutscene = true;
  }
  var lastStep:Int = 0;

  function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance?.isGameOverState ?? true) return;

    if (lastStep > event.step)
    {
      lastStep = event.step;
      return;
    }

    for (step in lastStep...event.step)
    {
      switch (step + 1)
      {
        case 384:
          PlayState.instance.currentStage.getGirlfriend().alpha = 0.001;
          deskfront.alpha = 0.001;
          blackScreenBG.alpha = 0.98;
          spotlight.alpha = 1;
          FunkinSound.playOnce(Paths.sound('gameplay/songs/neet/spotlight'));
        case 512:
          PlayState.instance.currentStage.getGirlfriend().alpha = 1;
          deskfront.alpha = 1;

          for (dokis in [sayori, yuri, monika, natsuki])
          {
            dokis.alpha = 1;
          }

          spotlight.alpha = 0;
          blackScreenBG.alpha = 0;
          FunkinSound.playOnce(Paths.sound('gameplay/songs/neet/spotlight'), 0.5);
      }
    }
    lastStep = event.step;
  }

  public function onCountdownStart(event):Void
  {
    super.onCountdownStart(event);

    if (!PlayStatePlaylist.isStoryMode) hasPlayedIntroCutscene = true;

    if (!hasPlayedIntroCutscene)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedIntroCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      startDialogue();
    }

    PlayState.instance.currentStage.getGirlfriend().alpha = 1;
    blackScreenBG.alpha = 0.0001;
    spotlight.alpha = 0.001;
    for (dokis in [sayori, yuri, monika, natsuki])
    {
      dokis.alpha = 0.001;
    }
  }

  function startDialogue()
  {
    PlayState.instance.tweenCameraToPosition(584, 434, 0);
    DokiConversationSystem.startConversation(this.id);
  }

  public override function onSongEnd(event:CountdownScriptEvent):Void
  {
    super.onSongEnd(event);
    if (!PlayStatePlaylist.isStoryMode) hasPlayedOutroCutscene = true;

    if (!hasPlayedOutroCutscene)
    {
      trace('Pausing countdown to play cutscene.');

      hasPlayedOutroCutscene = true;

      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camCutscene.visible = true;

      startEndDialogue();
    }
  }

  function playbackCutscene(name:String, ?length:Float):Void
  {
    PlayState.instance.camCutscene.fade(0xFF000000, length, false);
  }

  function startEndDialogue()
  {
    DokiConversationSystem.startConversation(this.id, 'End');
    DokiConversationSystem.dialogueBox.completeCallback = function()
    {
      DokiConversationSystem.onConversationComplete();
      PlayState.instance.endSong(true);
    };
  }
}
