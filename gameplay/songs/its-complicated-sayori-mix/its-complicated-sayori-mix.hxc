import funkin.play.PlayState;
import funkin.play.song.Song;
import funkin.save.Save;
import funkin.modding.module.ModuleHandler;

class ItsComplicatedSayoriMix extends Song
{
  function new()
  {
    super('its-complicated-sayori-mix');
  }

  var lastStep:Int = 0;

  function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance?.isGameOverState ?? true) return;

    if (lastStep > event.step)
    {
      lastStep = event.step;
      return;
    }

    for (step in lastStep...event.step)
    {
      switch (step + 1)
      {
        case 260:
          ModuleHandler.getModule('Credits').scriptCall('tweenIn');
        case 320:
          ModuleHandler.getModule('Credits').scriptCall('tweenOut');
      }
    }
    lastStep = event.step;
  }
}
