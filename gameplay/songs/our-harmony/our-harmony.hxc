import funkin.play.PlayState;
import flixel.tweens.FlxTween;
import funkin.graphics.FunkinSprite;
import funkin.audio.FunkinSound;
import flixel.tweens.FlxEase;
import funkin.play.song.Song;
import funkin.play.Countdown;
import funkin.Conductor;
import funkin.util.FlxTweenUtil;
import funkin.play.PlayStatePlaylist;
import funkin.play.character.CharacterDataParser;
import funkin.play.character.CharacterType;
import funkin.save.Save;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import funkin.modding.module.ModuleHandler;
import funkin.modding.module.Module;
import funkin.graphics.FunkinCamera;
import flixel.group.FlxTypedSpriteGroup;
import funkin.modding.module.Module;

class OurHarmonySong extends Song
{
  function new()
  {
    super('our-harmony');

    options = DokiPreferences.getDokiSave();
  }

  var playStrumDefaultPos:Array<Float> = [];
  var oppStrumDefaultPos:Array<Float> = [];
  var yuri:BaseCharacter;
  var natsuki:BaseCharacter;
  var cg1:FunkinSprite;
  var cg2:FunkinSprite;
  var cg2Group:FlxTypedSpriteGroup<FunkinSprite>;
  var whiteflash:FunkinSprite;
  var camGame2:FunkinCamera;

  var currentStage(get, never):Stage;

  function get_currentStage():Stage
  {
    return PlayState.instance?.currentStage;
  }

  public override function isSongNew(currentDifficulty:String):Bool
  {
    if (!Save.instance.hasBeatenSong(this.id)) return true;
    else
      return false;
  }

  override function onCreate(event)
  {
    super.onCreate(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;

    var opponentStrums = PlayState.instance.opponentStrumline.strumlineNotes;
    var playerStrums = PlayState.instance.playerStrumline.strumlineNotes;
    for (i in 0...4)
    {
      playStrumDefaultPos.push(opponentStrums.members[i].y);
      oppStrumDefaultPos.push(playerStrums.members[i].y);
    }

    yuri = addExtraCharacter('yuri', 'dad', {offsets: [200, -20], zIndex: currentStage._data.characters.dad.zIndex - 1});
    natsuki = addExtraCharacter('natsuki', 'dad', {offsets: [-200, 20], zIndex: currentStage._data.characters.dad.zIndex + 1});

    currentStage.refresh();

    camGame2 = new FunkinCamera('playStateCamGame2', FlxG.width / 2 - FlxG.initialWidth / 2, null, FlxG.initialWidth);
    FlxG.cameras.insert(camGame2, FlxG.cameras.list.indexOf(PlayState.instance.camHUD), false);
    camGame2.bgColor = 0x000000;

    cg1 = new FunkinSprite(0, 0).loadGraphic(Paths.image('gameplay/songs/${this.id}/CG/cg1'));
    cg1.alpha = 0.001;
    cg1.cameras = [camGame2];
    cg1.setGraphicSize(Std.int(cg1.width * 0.7)); // Smallest 0.67
    cg1.updateHitbox();
    cg1.screenCenter();
    cg1.scrollFactor.set();
    PlayState.instance.add(cg1);

    // Tween to -954x
    cg2 = new FunkinSprite(0, 0).loadGraphic(Paths.image('gameplay/songs/${this.id}/CG/cg2'));
    cg2.alpha = 0.001;
    cg2.cameras = [camGame2];
    cg2.scrollFactor.set();
    PlayState.instance.add(cg2);

    cg2Group = new FlxTypedSpriteGroup();
    cg2Group.cameras = [camGame2];
    cg2Group.scrollFactor.set();
    cg2Group.alpha = 0.001;
    PlayState.instance.add(cg2Group);

    // Why must you do this to me Team TBD
    cg2BG = new FunkinSprite(0, 0).loadGraphic(Paths.image('gameplay/songs/${this.id}/CG/bigone/cg2BG'));
    cg2BG.ID = 4;
    cg2Group.add(cg2BG);
    cg2Yuri = new FunkinSprite(0, 0).loadGraphic(Paths.image('gameplay/songs/${this.id}/CG/bigone/cg2Yuri'));
    cg2Yuri.ID = 3;
    cg2Group.add(cg2Yuri);
    cg2Sayo = new FunkinSprite(0, 0).loadGraphic(Paths.image('gameplay/songs/${this.id}/CG/bigone/cg2Sayo'));
    cg2Sayo.ID = 2;
    cg2Group.add(cg2Sayo);
    cg2Natsu = new FunkinSprite(0, 0).loadGraphic(Paths.image('gameplay/songs/${this.id}/CG/bigone/cg2Natsu'));
    cg2Natsu.ID = 1;
    cg2Group.add(cg2Natsu);
    cg2Moni = new FunkinSprite(0, 0).loadGraphic(Paths.image('gameplay/songs/${this.id}/CG/bigone/cg2Moni'));
    cg2Moni.ID = 0;
    cg2Group.add(cg2Moni);

    whiteflash = new FunkinSprite(-FlxG.width * FlxG.camera.zoom, -FlxG.height * FlxG.camera.zoom).makeGraphic(FlxG.width * 3, FlxG.height * 3, 0xFFFFFFFF);
    whiteflash.alpha = 0.0001;
    whiteflash.cameras = [PlayState.instance.camHUD];
    PlayState.instance.add(whiteflash);
  }
  
  function onNoteHit(callback)
  {
    if (PlayState.instance == null) return;

    switch (callback.note.noteData.kind)
    {
      case "GF Sing":
        yuri.holdTimer = 0;
        yuri.playSingAnimation(callback.note.noteData.getDirection(), false);
      case "Hurt Note":
        natsuki.holdTimer = 0;
        natsuki.playSingAnimation(callback.note.noteData.getDirection(), false);
    }
  }

  override function onUpdate(event:UpdateScriptEvent)
  {
    super.onUpdate(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;
    processNotes(event);
  }

  function stutterNotes(elapsed:Float):Void
  {
    // Process hold notes on the opponent's side.
    for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members)
    {
      if (holdNote == null || !holdNote.alive) continue;

      // While the hold note is being hit, and there is length on the hold note...
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0)
      {
        switch (holdNote.noteData.kind)
        {
          case "GF Sing":
            if (yuri.isSinging()) yuri.animation.curAnim.restart();
          case "Hurt Note":
            if (natsuki.isSinging()) natsuki.animation.curAnim.restart();
        }
      }
    }
  }

  function processNotes(elapsed:Float):Void
  {
    // Process hold notes on the opponent's side.
    for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members)
    {
      if (holdNote == null || !holdNote.alive) continue;

      // While the hold note is being hit, and there is length on the hold note...
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0)
      {
        switch (holdNote.noteData.kind)
        {
          case "GF Sing":
            if (yuri.isSinging()) yuri.holdTimer = 0;
          case "Hurt Note":
            if (natsuki.isSinging()) natsuki.holdTimer = 0;
        }
      }
    }
  }

  override function onSongEnd(event)
  {
    super.onSongEnd(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;

    camGame2.fade(0xFF000000, 0.6);
  }

  function addExtraCharacter(name:String, basedOn:String, data:Dynamic)
  {
    var stageCharData:StageDataCharacter = switch (basedOn)
    {
      case 'dad': currentStage._data.characters.dad;
      case 'bf': currentStage._data.characters.bf;
      case 'gf': currentStage._data.characters.gf;
    }
    var character:BaseCharacter = CharacterDataParser.fetchCharacter(name);
    currentStage.addCharacter(character, CharacterType.OTHER);
    character.zIndex = data.zIndex ?? stageCharData.zIndex;
    character.x = (stageCharData.position[0] - character.characterOrigin.x) + (data.offsets[0] ?? 0);
    character.y = (stageCharData.position[1] - character.characterOrigin.y) + (data.offsets[1] ?? 0);

    character.originalPosition.set(character.x, character.y);
    
    return character;
  }

  function calcSectionLength(?duration:Int = 1)
  {
    var durSeconds = (Conductor.instance.stepLengthMs * (16 * duration)) / 1000;
    return durSeconds;
  }

  public static function coolTextFile(path:String):Array<String>
  {
    var fullText:String = Assets.getText(Paths.txt(path));

    // Split into lines and remove empty lines
    var firstArray:Array<String> = fullText.split('\n').filter(function(s:String) return s != '');

    return firstArray;
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    PlayState.instance.cameraZoomRate = 4;
    FlxG.signals.postUpdate.addOnce(() -> {
      PlayState.instance.iconP2.configure({id: 'our-harmony'});
    });
    var opponentStrums = PlayState.instance.opponentStrumline.strumlineNotes;
    var playerStrums = PlayState.instance.playerStrumline.strumlineNotes;
    for (i in 0...4)
    {
      FlxTween.cancelTweensOf(opponentStrums.members[i]);
      FlxTween.cancelTweensOf(playerStrums.members[i]);
      opponentStrums.members[i].y = playStrumDefaultPos[i];
      playerStrums.members[i].y = oppStrumDefaultPos[i];
      opponentStrums.members[i].alpha = 1;
      playerStrums.members[i].alpha = 1;
    }
    FlxTween.cancelTweensOf(cg1);
    FlxTween.cancelTweensOf(cg2);
    FlxTween.cancelTweensOf(whiteflash);
    cg1.scale.set(0.7, 0.7); // Smallest 0.67
    cg1.alpha = 0;
    cg1.screenCenter();
    cg2.alpha = 0;
    cg2.screenCenter();
    var hueh231 = ModuleHandler.getModule("coolgameplay").scriptGet("hueh231", []);
    if (hueh231 != null) hueh231.visible = true;
    whiteflash.alpha = 0;
    for (item in cg2Group.members)
    {
      FlxTween.cancelTweensOf(item);
      item.x = 0;
    }
    cg2Group.alpha = 0;
    for (hud in [PlayState.instance.healthBarBG, PlayState.instance.healthBar, PlayState.instance.iconP1, PlayState.instance.iconP2, PlayState.instance.scoreText])
    {
      FlxTween.cancelTweensOf(hud);
      hud.alpha = 1;
    }
  }

  function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;
    if (options.psychholds) stutterNotes();

    if (event.step >= 2448 && PlayState.instance.vocals.playerVolume != 1) PlayState.instance.vocals.playerVolume = 1;
    switch (event.step)
    {
      case 2420:
        FlxTween.tween(PlayState.instance.healthBarBG, {alpha: 0}, 2, {ease: FlxEase.sineIn});
        FlxTween.tween(PlayState.instance.healthBar, {alpha: 0}, 2, {ease: FlxEase.sineIn});
        FlxTween.tween(PlayState.instance.iconP1, {alpha: 0}, 2, {ease: FlxEase.sineIn});
        FlxTween.tween(PlayState.instance.iconP2, {alpha: 0}, 2, {ease: FlxEase.sineIn});
        FlxTween.tween(PlayState.instance.scoreText, {alpha: 0}, 2, {ease: FlxEase.sineIn});

        FlxTween.tween(PlayState.instance.playerStrumline.background, {alpha: 0}, 2, {ease: FlxEase.sineIn});
        FlxTween.tween(PlayState.instance.opponentStrumline.background, {alpha: 0}, 2, {ease: FlxEase.sineIn});

        FlxTween.tween(whiteflash, {alpha: 1}, 2, {ease: FlxEase.sineIn});
      case 2432:
        var opponentStrums = PlayState.instance.opponentStrumline.strumlineNotes;
        var playerStrums = PlayState.instance.playerStrumline.strumlineNotes;
        for (i in 0...4)
        {
          FlxTween.tween(opponentStrums.members[i], {y: opponentStrums.members[i].y - 10, alpha: 0}, 1, {ease: FlxEase.circOut, startDelay: 0.5 + (0.1 * i)});
          FlxTween.tween(playerStrums.members[i], {y: playerStrums.members[i].y - 10, alpha: 0}, 1, {ease: FlxEase.circOut, startDelay: 0.5 + (0.1 * i)});
        }
      case 2448:
        var hueh231 = ModuleHandler.getModule("coolgameplay").scriptGet("hueh231", []);
        if (hueh231 != null) hueh231.visible = false;

        cg1.alpha = 1;
        PlayState.instance.vocals.playerVolume = 1;
        PlayState.instance.cameraZoomRate = 0;
        FlxTween.tween(cg1.scale, {x: 0.67, y: 0.67}, 5, {ease: FlxEase.sineIn});
        FlxG.camera.zoom = currentStage.camZoom;
      case 2456:
        FlxTween.tween(whiteflash, {alpha: 0}, 2, {ease: FlxEase.sineIn});
      case 2568:
        FlxTween.tween(whiteflash, {alpha: 1}, 0.57, {ease: FlxEase.sineIn});
      case 2578:
        cg1.alpha = 0;
        cg2.alpha = 1;
        FlxTween.tween(whiteflash, {alpha: 0}, 1, {ease: FlxEase.sineIn});
        FlxTween.tween(cg2, {x: -954}, 9, {ease: FlxEase.sineIn});
      case 2590:
        // end here
      case 2674:
        FlxTween.tween(whiteflash, {alpha: 1}, 1, {ease: FlxEase.sineIn});
      case 2694:
        cg2.alpha = 0;
        cg2Group.alpha = 1;

        for (item in cg2Group.members)
          FlxTween.tween(item, {x: -250}, 17 + (1 * item.ID), {ease: FlxEase.sineIn});

        FlxTween.tween(whiteflash, {alpha: 0}, 1, {ease: FlxEase.sineIn});
      // Fade out
      case 2702:
        // End here
    }
  }
}
