class OurHarmonySong extends Song
{
  function new()
  {
    super('our-harmony');
  }

  var playStrumDefaultPos:Array<Float> = [];
  var oppStrumDefaultPos:Array<Float> = [];
  var yuri:BaseCharacter;
  var natsuki:BaseCharacter;
  var cg1:FunkinSprite;
  var cg2:FunkinSprite;
  var cg2Group:FlxTypedSpriteGroup<FunkinSprite>;
  var whiteflash:FunkinSprite;
  var ending:FunkinVideoSprite;

  var currentStage(get, never):Stage;

  function get_currentStage():Stage
  {
    return PlayState.instance?.currentStage;
  }

  public override function isSongNew(currentDifficulty:String):Bool
  {
    if (!Save.instance.hasBeatenSong(this.id)) return true;
    else
      return false;
  }

  override function onCreate(event)
  {
    super.onCreate(event);
    if (currentStage == null || PlayState.instance.isMinimalMode) return;

    var opponentStrums = PlayState.instance.opponentStrumline.strumlineNotes;
    var playerStrums = PlayState.instance.playerStrumline.strumlineNotes;
    for (i in 0...4)
    {
      playStrumDefaultPos.push(opponentStrums.members[i].y);
      oppStrumDefaultPos.push(playerStrums.members[i].y);
    }

    yuri = addExtraCharacter('yuri', 'dad', {offsets: [200, -20], zIndex: currentStage._data.characters.dad.zIndex - 1});
    natsuki = addExtraCharacter('natsuki', 'dad', {offsets: [-200, 20], zIndex: currentStage._data.characters.dad.zIndex + 1});

    currentStage.refresh();

    // Whole section below replaced by a video thanks to RagdollClash
    /*
    cg1 = new FunkinSprite(0, 0).loadGraphic(Paths.image('gameplay/songs/${this.id}/CG/cg1'));
    cg1.alpha = 0.001;
    cg1.cameras = [camGame2];
    cg1.setGraphicSize(Std.int(cg1.width * 0.7)); // Smallest 0.67
    cg1.updateHitbox();
    cg1.screenCenter();
    cg1.scrollFactor.set();
    PlayState.instance.add(cg1);

    // Tween to -954x
    cg2 = new FunkinSprite(0, 0).loadGraphic(Paths.image('gameplay/songs/${this.id}/CG/cg2'));
    cg2.alpha = 0.001;
    cg2.cameras = [camGame2];
    cg2.scrollFactor.set();
