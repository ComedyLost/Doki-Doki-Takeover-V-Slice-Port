import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.graphics.FunkinSprite;
import funkin.graphics.FunkinBackdrop;
import flixel.tweens.FlxTween;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.util.FlxTimer;
import funkin.modding.base.ScriptedFlxRuntimeShader;
import openfl.filters.ShaderFilter;
import flixel.addons.display.FlxRuntimeShader;
import openfl.utils.Assets;
import funkin.graphics.FunkinCamera;
import flixel.FlxCamera;
import flixel.FlxCameraFollowStyle;
import funkin.save.Save;
import funkin.Conductor;
import flixel.tweens.FlxEase;
import flixel.math.FlxPoint;

class EvilClubroomStage extends Stage
{
  var dokiBackdrop:FunkinBackdrop;
  var space:FunkinBackdrop;
  var clouds:FunkinBackdrop;
  var fancyclouds:FunkinBackdrop;
  var popup:FunkinSprite;
  var blackCover:FunkinSprite;
  var maskEnabled:Bool;
  var canChange:Bool;
  var bloom = new FlxRuntimeShader(Assets.getText(Paths.frag("ui/shaders/BloomShader")));
  var shaderstat = new ShaderFilter(bloom);
  var camBG:FunkinCamera;

  var stageCamera:FlxPoint = FlxPoint.get();

  final STAGE_PATH:String = 'gameplay/stages/clubroomevil';
  function new()
  {
    super('clubroomevil');

    save = DokiPreferences.getDokiSave();
  }

  public function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    canChange = true;
    blackCover.alpha = 0;
    dokiBackdrop.alpha = 0;
    PlayState.instance.iconP2.alpha = 1;
    camBG.focusOn(PlayState.instance.cameraFollowPoint.getPosition());
    getBoyfriend().visible = false;
    getGirlfriend().visible = false;
    bloom.setFloat('funrange', 0.1);
    bloom.setFloat('funsteps', 0.005);
    bloom.setFloat('funthreshhold', 0.95);
    bloom.setFloat('funbrightness', 8);
    if (save.bloom) camBG.filters = [shaderstat];
  }

  override function buildStage()
  {
    // I'm never going to fully understand V-Slice coding
    // 2026 and it's still true :whatthecrying:
    super.buildStage();
    camBG = new FunkinCamera('playStateCamBG');
    camBG.bgColor = 0x000000;
    camBG.copyFrom(PlayState.instance.camGame);
    camBG.target = null;
    FlxG.cameras.insert(camBG, FlxG.cameras.list.indexOf(PlayState.instance.camGame), false);
    PlayState.instance.camGame.bgColor = 0x0;
    getNamedProp('Epiphany Main Lights').blend = 12;
    getNamedProp('Epiphany Window Lights').cameras = [camBG];
    getNamedProp('Epiphany BG').cameras = [camBG];
    canChange = true;
    maskEnabled = true;
    blackCover = new FunkinSprite(0, 0).makeSolidColor(FlxG.width * 1.5, FlxG.height * 1.5, 0xFF000000);
    blackCover.zIndex = 500;
    blackCover.alpha = 0;
    blackCover.cameras = [PlayState.instance.camHUD];
    blackCover.screenCenter();
    blackCover.y = -300;
    add(blackCover);
    popup = FunkinSprite.createSparrow(0, 0, '$STAGE_PATH/monika-delete-prompt');
    popup.animation.addByPrefix('startDeleting', 'PopUpAnim', 24, false);
    popup.zIndex = 400;
    popup.screenCenter();
    popup.alpha = 0;
    popup.y += 100;
    popup.x += 75;
    add(popup);
    dokiBackdrop = new FunkinBackdrop(Paths.image('ui/doki-general/scrolling-bg'));
    dokiBackdrop.updateHitbox();
    dokiBackdrop.zIndex = 100;
    dokiBackdrop.velocity.set(-40, -40);
    dokiBackdrop.alpha = 0;
    dokiBackdrop.screenCenter();
    add(dokiBackdrop);
    space = new FunkinBackdrop(Paths.image('$STAGE_PATH/sky'));
    space.updateHitbox();
    space.zIndex = 10;
    space.scrollFactor.set(0.1, 0.1);
    space.velocity.set(-7, 0);
    space.alpha = 1;
    space.screenCenter();
    add(space);
    space.cameras = [camBG];
    clouds = new FunkinBackdrop(Paths.image('$STAGE_PATH/clouds'));
    clouds.updateHitbox();
    clouds.zIndex = 10;
    clouds.scrollFactor.set(0.1, 0.1);
    clouds.velocity.set(-13, 0);
    clouds.alpha = 1;
    add(clouds);
    clouds.cameras = [camBG];
    fancyclouds = new FunkinBackdrop(Paths.image('$STAGE_PATH/mask'));
    fancyclouds.updateHitbox();
    fancyclouds.zIndex = 10;
    fancyclouds.scrollFactor.set(0.1, 0.1);
    fancyclouds.velocity.set(-13, 0);
    fancyclouds.alpha = 1;
    add(fancyclouds);
    fancyclouds.cameras = [camBG];
    refresh();

    var bg:StageProp = getNamedProp('Epiphany BG');
    stageCamera.set(bg.x + (bg.width / 2), bg.y + (bg.height / 2));
  }

  override function onUpdate(event:UpdateScriptEvent)
  {
    super.onUpdate(event);

    camBG.zoom = PlayState.instance.camGame.zoom;
    camBG.scroll = FlxG.camera.scroll;
  }

  function maskStateChange()
  {
    if (!canChange) return;
    if (!maskEnabled)
    {
      canChange = false;
      FlxTween.tween(getNamedProp('Epiphany Window Lights'), {alpha: 1}, 1);
      maskEnabled = true;
      FlxTween.tween(fancyclouds, {alpha: 1}, 1);
      new FlxTimer().start(3, function(tmr)
      {
        canChange = true;
      });
    }
    else if (maskEnabled)
    {
      canChange = false;
      FlxTween.tween(getNamedProp('Epiphany Window Lights'), {alpha: 0}, 1);
      maskEnabled = false;
      FlxTween.tween(fancyclouds, {alpha: 0}, 1);
      new FlxTimer().start(3, function(tmr)
      {
        canChange = true;
      });
    }
  }

  function calcSectionLength(?duration:Int = 1)
  {
    var durSeconds = (Conductor.instance.stepLengthMs * (16 * duration)) / 1000;
    return durSeconds;
  }

  function onBeatHit(event:SongTimeScriptEvent):Void
  {
    if (FlxG.random.bool(20))
    {
      maskStateChange();
    }
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    getDad().dance(true);
    getDad().alpha = 1;
    if (popup.animation?.curAnim?.name == 'startDeleting')
    {
      popup.animation.curAnim.stop();
    }
    var opponentStrumline:FunkinSprite = PlayState.instance.opponentStrumline;
    if (opponentStrumline != null)
    {
      for (arrow in opponentStrumline.members)
      {
        FlxTween.cancelTweensOf(arrow);
        if (arrow == opponentStrumline.background) continue;
        arrow.alpha = 1;
      }
    }
    FlxTween.cancelTweensOf(blackCover);
    FlxTween.cancelTweensOf(dokiBackdrop);
    FlxTween.cancelTweensOf(PlayState.instance.iconP2);
    blackCover.alpha = 0;
    dokiBackdrop.alpha = 0;
    PlayState.instance.iconP2.alpha = 1;
    popup.alpha = 0;
  }
}
