import funkin.play.PlayState;
import funkin.play.stage.Stage;
import flixel.FlxCamera;
import funkin.play.character.CharacterType;

class DokiClubroomStage extends Stage
{
  function new()
  {
    super('dokiclubroom');
  }

  final NO_BG_CHAR_SONGS:Array<String> = ["dokidoggle", "catfight", "obsession", "constricted", "neet"];

  var sayori:StageProp;
  var natsuki:StageProp;
  var monika:StageProp;
  var protag:StageProp;
  var yuri:StageProp;

  function setDokiPosition(character:String)
  {
    if (NO_BG_CHAR_SONGS.contains(PlayState.instance.currentSong.id))
    {
      for (bg in [sayori, natsuki, yuri, monika, protag])
      {
        bg.alpha = 0.0001;
      }
      return;
    }
    natsuki.alpha = 1;
    yuri.alpha = 1;
    monika.alpha = 0.0001;
    sayori.alpha = 1;
    protag.alpha = 0.0001;
    if (PlayState.instance.currentSong.id == "neet") monika.alpha = 1;
    switch (character)
    {
      case "natsuki":
        natsuki.alpha = 0.0001;
        sayori.setPosition(-49, 247);
        yuri.setPosition(1044, 178);
        protag.setPosition(379, 152);
        monika.setPosition(1207, 173);
      case "yuri", "yuri-crazy":
        yuri.alpha = 0.0001;
        sayori.setPosition(-49, 247);
        natsuki.setPosition(1044, 290);
        protag.setPosition(379, 152);
        monika.setPosition(1207, 173);
      case "sayori":
        sayori.alpha = 0.0001;
        yuri.setPosition(-74, 176);
        natsuki.setPosition(1044, 290);
        protag.setPosition(379, 152);
        monika.setPosition(1207, 173);
      case "monika":
        monika.alpha = 0.0001;
        sayori.setPosition(-49, 247);
        yuri.setPosition(1044, 178);
        natsuki.setPosition(1247, 303);
        protag.setPosition(150, 152);
    }
  }

  override function buildStage()
  {
    super.buildStage();
    sayori = getNamedProp('BG Sayori');
    natsuki = getNamedProp('BG Natsuki');
    yuri = getNamedProp('BG Yuri');
    monika = getNamedProp('BG Monika');
    protag = getNamedProp('BG Protag');
    getNamedProp('Club Lights').blend = 12;
  }

  public function onSongRetry(event):Void
  {
    super.onSongRetry(event);
    setDokiPosition(PlayState.instance.currentChart.characters.opponent);
  }

  public function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    super.addCharacter(character, charType);
    if (charType == CharacterType.DAD)
    {
      setDokiPosition(character.characterId);
    }
  }
}
