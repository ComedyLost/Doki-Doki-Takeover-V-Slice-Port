import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.graphics.FunkinSprite;
import funkin.graphics.FunkinBackdrop;
import flixel.util.FlxTimer;
import openfl.filters.ShaderFilter;
import flixel.addons.display.FlxRuntimeShader;
import funkin.graphics.FunkinCamera;
import flixel.math.FlxPoint;
import funkin.ui.FullScreenScaleMode;
import funkin.play.character.CharacterType;

class WiltedStage extends Stage
{
  function new()
  {
    super('wilted');
  }

  var time:Float = 0;
  var dokiBackdrop:FunkinBackdrop;
  var creditsBG:FunkinBackdrop;
  var camBG:FunkinCamera;

  var fish:FlxRuntimeShader = new FlxRuntimeShader(Assets.getText(Paths.frag("ui/shaders/FishEyeShader")));
  var fishshader:ShaderFilter = new ShaderFilter(fish);

  var staticShader:FlxRuntimeShader = new FlxRuntimeShader(Assets.getText(Paths.frag("ui/shaders/StaticShader")));
  var shaderstat:ShaderFilter = new ShaderFilter(staticShader);

  override function onUpdate(event:UpdateScriptEvent)
  {
    super.onUpdate(event);
    time++;
    staticShader.setFloat('iTime', time);

    camBG.zoom = FlxG.camera.zoom;
    camBG.scroll = FlxG.camera.scroll;
  }

  override function buildStage()
  {
    super.buildStage();
    camBG = new FunkinCamera('playStateCamBG');
    camBG.bgColor = 0xFFFFFF;

    camBG.copyFrom(PlayState.instance.camGame);
    camBG.focusOn(PlayState.instance.cameraFollowPoint.getPosition());

    FlxG.cameras.insert(camBG, FlxG.cameras.list.indexOf(PlayState.instance.camGame), false);
    PlayState.instance.camGame.bgColor = 0x0;

    dokiBackdrop = new FunkinBackdrop(Paths.image('ui/doki-general/scrolling-bg'));
    dokiBackdrop.scrollFactor.set(0.1, 0.1);
    dokiBackdrop.velocity.set(-10, 0);
    dokiBackdrop.alpha = 0.3;
    dokiBackdrop.zIndex = 10;
    add(dokiBackdrop);
    dokiBackdrop.cameras = [camBG];

    creditsBG = new FunkinBackdrop(Paths.image('gameplay/stages/credits/poc-background'));
    creditsBG.scrollFactor.set(0.1, 0.1);
    creditsBG.velocity.set(-50, 0);
    creditsBG.zIndex = 20;
    add(creditsBG);
    creditsBG.cameras = [camBG];

    var scanline:FunkinBackdrop = new FunkinBackdrop(Paths.image('gameplay/stages/credits/scanlines'));
    scanline.scrollFactor.set(0.1, 0.1);
    scanline.velocity.set(0, 20);
    add(scanline);
    scanline.cameras = [camBG];

    var gradient:FunkinSprite = new FunkinSprite().loadGraphic(Paths.image('gameplay/stages/credits/gradent'));
    gradient.scrollFactor.set(0.1, 0.1);
    gradient.screenCenter();
    gradient.setGraphicSize(Std.int(gradient.width * 1.6));
    add(gradient);
    gradient.cameras = [camBG];

    getNamedProp('Wilted BG').x += 80 * (FullScreenScaleMode.wideScale.x - 1);
    // getNamedProp('Wilted Window').x	+= FullScreenScaleMode.gameCutoutSize.x / 2.5;
    var window:StageProp = getNamedProp('Wilted Window');
    stageCamera.set(window.x + (window.width / 2), window.y + (window.height / 2));
  }

  var stageCamera:FlxPoint = FlxPoint.get();

  public function onCountdownStart(event):Void
  {
    super.onCountdownStart(event);
    camBG.focusOn(PlayState.instance.cameraFollowPoint.getPosition());
    camBG.filters = [fishshader];
    camBG.zoom = 0.7;
    fish.setFloat('warp', -1.5);
    fish.setFloat('scan', 0);
    // FlxG.camera.follow(PlayState.instance.currentStage.getGirlfriend(), null, 1);
    PlayState.instance.currentStage.getGirlfriend().alpha = 0;
  }

  public override function onSongEvent(scriptEvent:SongEventScriptEvent)
  {
    if (scriptEvent.eventData.eventKind == "FocusCamera")
    {
      if (scriptEvent.eventCanceled) return;
      var eventProps = scriptEvent.eventData.value;
      switch (Std.parseInt(eventProps.char))
      {
        case 2:
          scriptEvent.cancel();
          scriptEvent.eventData.activated = true;
          var targetX = eventProps.x;
          var targetY = eventProps.y;
          targetX += stageCamera.x;
          targetY += stageCamera.y;
          PlayState.instance.resetCamera(false, false, false);
          PlayState.instance.cancelCameraFollowTween();
          PlayState.instance.cameraFollowPoint.setPosition(targetX, targetY);
      }
    }
  }

  function glitchEffect()
  {
    // I got the real shaders to work
    PlayState.instance.camGame.filters = [shaderstat];
    new FlxTimer().start(0.2, function(e:FlxTimer)
    {
      PlayState.instance.camGame.filters = [];
    });
  }

  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    // Apply the shader automatically to each character as it gets added.
    super.addCharacter(character, charType);

    if (character.characterId == 'monika' && charType == CharacterType.BF)
    {
      character.originalPosition.x = character.x -= 50;
    }
  }  
}
