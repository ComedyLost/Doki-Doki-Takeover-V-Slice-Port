import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.graphics.FunkinSprite;
import funkin.ui.FullScreenScaleMode;

class MusicRoomStage extends Stage
{
  function new()
  {
    super('musicroom');
  }

  final STAGE_PATH:String = 'gameplay/stages/musicroom';

  override function buildStage()
  {
    super.buildStage();
    switch (PlayState.instance.currentSong.id)
    {
      case "shrinking-violet":
        if (PlayState.instance.currentVariation == 'alt') getNamedProp('Music Room BG').loadGraphic(Paths.image('$STAGE_PATH/room-spooky'));
      case "love-n-funkin":
        getNamedProp('Music Room BG').loadGraphic(Paths.image('$STAGE_PATH/room-lnf'));
    }
    if (DokiPreferences.nowidescreen && PlayState.instance.camGame.width > FlxG.initialWidth)
    {
      PlayState.instance.camGame.setPosition((FlxG.width - FlxG.initialWidth) / 2, (FlxG.height - FlxG.initialHeight) / 2);
      PlayState.instance.camGame.setSize(FlxG.initialWidth, FlxG.initialHeight);
    }
  }
}
