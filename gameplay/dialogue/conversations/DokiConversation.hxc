package ddto.cutscene;

import funkin.play.cutscene.dialogue.Conversation;
import funkin.play.PlayState;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import ddto.gameplay.dialogue.DokiDialogueBox;

using StringTools;

/**
 * A completely overidden class that overlays the original DDTO conversation system
 * over V-Slice Funkin's conversation system.
 * 
 * This allows the game to use DDTO's cutscene jsons for events
 * which will hopefully bring a one-to-one experience with the original DDTO
 * while still allowing base game functions to work like cutscene skipping
 */
class DokiConversation extends Conversation
{
  function new(id:String, ?params:Dynamic)
  {
    super((id == 'unknown' ? 'rain-clouds' : id), null);

    dokiDialogueBox = new DokiDialogueBox
  }

  var dokiDialogueBox:DokiDialogueBox;

  override function get_currentDialogueLineString():String
  {
    // TODO: Replace "" with some placeholder text?
    return currentDialogueEntryData?.text[currentDialogueLine] ?? '';
  }
}
