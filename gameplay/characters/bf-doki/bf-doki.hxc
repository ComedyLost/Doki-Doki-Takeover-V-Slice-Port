import funkin.play.character.MultiAnimateAtlasCharacter;
import funkin.play.PlayState;
import funkin.play.GameOverSubState;
import funkin.play.PauseSubState;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import lime.app.Application;
import funkin.play.character.CharacterDataParser;
import openfl.system.System;

class BFDokiNewCharacter extends MultiAnimateAtlasCharacter
{
  var isEpiphany:Bool;
  var isLyrics:Bool;
  var deathSpriteMonika:FunkinSprite;

  // Don't swap costumes on these songs as the characters might not have assets for them
  final NON_SWAPPABLE_SONGS:Array<String> = ['epiphany', 'tutorial'];

  function new()
  {
    super('bf-doki');
  }

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);
    GameOverSubState.musicSuffix = '-doki';
    GameOverSubState.blueBallSuffix = '-doki';

    PauseSubState.musicSuffix = '-doki';

    if (PlayState.instance == null)
    {
      isEpiphany = false;
      isLyrics = false;
      return;
    }
    isEpiphany = (PlayState.instance.currentSong?.id?.toLowerCase() == 'epiphany');
    isLyrics = (isEpiphany && PlayState.instance.currentVariation == 'lyrics');
    if (isEpiphany) GameOverSubState.blueBallSuffix = '-bigmonika';
    if (!isLyrics && FlxG.random.bool(0.05)) GameOverSubState.blueBallSuffix = '-rare';
  }

  function createDeathSprites()
  {
    var normalPath:String = switch (isLyrics)
    {
      case true: 'gameplay/characters/bigmonika-dress/death';
      case false: 'gameplay/characters/bigmonika/death';
    }
    var assetLibrary:String = Paths.getLibrary(normalPath);
    var assetPath:String = Paths.stripLibrary(normalPath);

    if (deathSpriteMonika != null && !deathSpriteMonika.alive)
    {
      deathSpriteMonika.revive();
    }
  
    deathSpriteMonika = FunkinSprite.createTextureAtlas(0, 0, assetPath, assetLibrary);
    var opponent = currentStage.getDad();
    deathSpriteMonika.x = opponent.originalPosition.x;
    deathSpriteMonika.y = opponent.originalPosition.y;
    deathSpriteMonika.anim.addByFrameLabel('firstDeath', 'First Death', 24, false);
    deathSpriteMonika.anim.addByFrameLabel('deathLoop', 'Death Loop', 24, true);
    deathSpriteMonika.anim.addByFrameLabel('deathConfirm', 'Death Confirm', 24, false);
    if (!isLyrics) deathSpriteMonika.anim.addByFrameLabel('finalDeath', 'Final Death', 24, false);
    deathSpriteMonika.animation.onFinish.add(function(name:String)
    {
      if (name == 'firstDeath')
      {
        GameOverSubState.instance.startDeathMusic(1.0, false);
        deathSpriteMonika.animation.play('deathLoop', true);
      }
      else if (name == 'finalDeath') System.exit(1);
    });  
  }

  function playAnimation(name:String, restart:Bool, ignoreOther:Bool)
  {
    super.playAnimation(name, restart, ignoreOther);
    if (this.debug || GameOverSubState.instance == null) return;
    if (isEpiphany)
    {
      switch (name)
      {
        case 'firstDeath':
          GameOverSubState.instance.resetCameraZoom();
          var gfPoint = currentStage.getGirlfriend().cameraFocusPoint;
          PlayState.instance.tweenCameraToPosition(gfPoint.x, gfPoint.y, 0);
          createDeathSprites();
          GameOverSubState.instance.add(deathSpriteMonika);
          GameOverSubState.instance.remove(this);
          if (GameOverSubState.blueBallSuffix != '-rare')
          {
            deathSpriteMonika.animation.play("firstDeath");
          }
          else
          {
            FlxG.state.subState.mustNotExit = true;
            deathSpriteMonika.animation.play("finalDeath");
          }
        case 'deathConfirm':
          deathSpriteMonika.animation.play("deathConfirm");
          PlayState.instance.subStateClosed.addOnce((_) ->
          {
            deathSpriteMonika.kill();
          });      
      }
    }
  }
}
