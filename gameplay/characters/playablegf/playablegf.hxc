import funkin.play.character.MultiSparrowCharacter;
import funkin.play.PlayState;
import funkin.play.GameOverSubState;
import funkin.play.PauseSubState;
import StringTools;
import flixel.util.FlxSave;
import Reflect;
import thx.Dynamics;

using funkin.util.tools.ArrayTools;
using funkin.util.AnsiUtil;

class PlayableGFDokiCharacter extends MultiSparrowCharacter
{
  var SaveData:FlxSave;

  function new()
  {
    super('playablegf');
    var save = new FlxSave();
    save.bind("CostumesV2", "FunkinCrew");
    SaveData = save.data;
    DEFAULT_PATH = _data.assetPath;
    var _clonedData:CharacterData = Dynamics.clone(_data); // Duplicate to prevent modifying the cached version
    _clonedData.assetPath = getCostumePath();
    Reflect.setField(super, '_data', _clonedData); // It's no longer possible to write to finals
  }
  
  private var DEFAULT_PATH:Null<String> = null;

  var festivalStages:Array<String> = ['dokifestival', 'dokiglitcher'];

  public var currentCostume(get, never):String;

  function get_currentCostume():String
  {
    var costumeName:String = Reflect.field(SaveData, '${_data.costumes}costume') ?? '';
    if (costumeName == '') return 'default';
    return costumeName;
  }

  final FESTIVAL_COLORS:Array<FlxColor> = [0x828282, 0x424282];

  final DEFAULT_COLORS:Array<FlxColor> = [0xFFFFFF, 0x8282FF];

  public var defaultColor(get, never):FlxColor;

  function get_defaultColor():FlxColor
  {
    if (PlayState.instance == null) return DEFAULT_COLORS[0];
    if (festivalStages.contains(PlayState.instance.currentStageId.toLowerCase())) return FESTIVAL_COLORS[0];
    return DEFAULT_COLORS[0];
  }

  public var missColor(get, never):FlxColor;

  function get_missColor():FlxColor
  {
    if (PlayState.instance == null) return DEFAULT_COLORS[1];
    if (festivalStages.contains(PlayState.instance.currentStageId.toLowerCase())) return FESTIVAL_COLORS[1];
    return DEFAULT_COLORS[1];
  }

  public function onCreate(event):Void
  {
    super.onCreate(event);
    this.color = defaultColor;
    GameOverSubState.musicSuffix = '-doki';
    GameOverSubState.blueBallSuffix = '';

    PauseSubState.musicSuffix = '-doki';
  }

  private function getCostumePath():String
  {
    if (_data.costumelist == null) return DEFAULT_PATH;

    if (currentCostume == 'default') return DEFAULT_PATH;

    for (costume in _data.costumelist)
    {
      var internal_name:String = costume.internal_Name;
      var assetPath:String = costume.assetPath;

      if (internal_name != currentCostume) continue;

      trace(' DDTO '.bold().bg_magenta() + ' Found costume: $internal_name | $assetPath');
      return assetPath;
    }

    return DEFAULT_PATH;
  }

  override public function playSingAnimation(dir:Int, miss:Bool = false, ?suffix:String = ""):Void
  {
    holdTimer = 0;
    if (miss)
    {
      this.color = missColor;
      super.playSingAnimation(dir, false, suffix);
    }
    else
    {
      this.color = defaultColor;
      super.playSingAnimation(dir, miss, suffix);
    }
  }

  override public function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false):Void
  {
    // FlxG.watch.addQuick('playAnim(${characterName})', name);
    if (!StringTools.contains(name, 'sing')) this.color = defaultColor;
    super.playAnimation(name, restart, ignoreOther, reversed);
  }

  function onNoteMiss(event:NoteScriptEvent)
  {
    if (event.eventCanceled) return;
    super.onNoteMiss(event);
  }
}
