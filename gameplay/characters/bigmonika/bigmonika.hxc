import funkin.play.character.AnimateAtlasCharacter;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import funkin.save.Save;

class BigMonikaCharacter extends AnimateAtlasCharacter
{
  function new()
  {
    super('bigmonika');

    ignoreExclusionPref.push('lastNOTE');
  }

  override function onAnimationFinished(name:String)
  {
    super.onAnimationFinished(name);
    if (this.debug) return;
    if (PlayState.instance?.currentStage == null) return;
    switch (name)
    {
      case 'lastNOTE_start':
        if (!Save.instance.hasBeatenSong('epiphany', ['normal']))
        {
          this.playAnimation('lastNOTE_end', true, true, false);
        }
        else
        {
          this.playAnimation('lastNOTE_retry', true, true, false);
        }
      case 'lastNOTE_end', 'lastNOTE_retry': this.alpha = 0;
    }
  }

  function onNoteHit(event:NoteScriptEvent)
  {
    // Override the miss note animation.
    switch (event.note.kind)
    {
      case "markov", "noanimation":
        return;
      default:
        super.onNoteHit(event);
    }
  }
}
