import funkin.play.character.AnimateAtlasCharacter;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import funkin.save.Save;

class BigMonikaCharacter extends AnimateAtlasCharacter
{
  function new()
  {
    super('bigmonika');

    ignoreExclusionPref.push('lastNOTE');
  }

  override function onAnimationFinished(name:String)
  {
    super.onAnimationFinished(name);
    if (this.debug) return;
    if (PlayState.instance?.currentStage == null) return;
    switch (name)
    {
      case 'lastNOTE_start':
        if (!hasBeatenSong('epiphany', ['normal']))
        {
          this.playAnimation('lastNOTE_end', true, true, false);
        }
        else
        {
          this.playAnimation('lastNOTE_retry', true, true, false);
        }
      case 'lastNOTE_end', 'lastNOTE_retry':
        this.alpha = 0;
    }
  }
  
  public function hasBeatenSong(songId:String, ?difficultyList:Array<String>, ?variation:String):Bool
  {
    if (difficultyList == null)
    {
      difficultyList = ['easy', 'normal', 'hard'];
    }
    if (variation == null) variation = '';
    for (difficulty in difficultyList)
    {
      if (variation != '') difficulty = '${difficulty}-${variation}';
      var score:Null<SaveScoreData> = Save.instance.getSongScore(songId, difficulty);
      if (score != null)
      {
        if (score.score > 0)
        {
          // Level has score data, which means we cleared it!
          return true;
        }
        else
        {
          // Level has score data, but the score is 0.
          continue;
        }
      }
    }
    return false;
  }

  function onNoteHit(event:NoteScriptEvent)
  {
    // Override the miss note animation.
    switch (event.note.kind)
    {
      case "markov", "noanimation":
        return;
      default:
        super.onNoteHit(event);
    }
  }
}
