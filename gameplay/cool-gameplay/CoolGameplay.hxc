import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.PlayerSettings;
import funkin.Highscore;
import funkin.audio.FunkinSound;
import funkin.save.Save;
import funkin.graphics.FunkinSprite;

class CoolGameplay extends Module
{
  function new()
  {
    super("coolgameplay");
  }

  var hueh231:FunkinSprite;
  var ddtoStages:Array<String> = ['schoolDDTO', 'schoolEvilDDTO', 'va11halla', 'dokiclubroom', 'dokifestival', 'dokiglitcher', 'musicroom', 'clubroomevil', 'youandme', 'wilted', 'libitina', 'credits'];

  override function onDestroy(event)
  {
    super.onDestroy(event);
    if (hueh231 != null) hueh231 = null;
  }

  override function onCountdownStart(event)
  {
    super.onCountdownStart(event);
    if (!ddtoStages.contains(PlayState.instance.currentStageId)) return;
    if (!DokiPreferences.cool || hueh231 != null) return;
    hueh231 = new FunkinSprite();
    hueh231.frames = Paths.getSparrowAtlas('gameplay/cool-gameplay/cool-gameplay');
    hueh231.animation.addByPrefix('idle', 'Symbol', 24, true);
    hueh231.animation.play('idle');
    hueh231.scrollFactor.set();
    hueh231.updateHitbox();
    hueh231.screenCenter();
    hueh231.zIndex = 700;
    hueh231.cameras = [PlayState.instance.camHUD];
    PlayState.instance.add(hueh231);
  }
}
