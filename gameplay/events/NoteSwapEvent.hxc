import funkin.play.PlayState;
import funkin.play.event.ScriptedSongEvent;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.FunkinMemory;
import funkin.mobile.input.ControlsHandler;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.play.notes.notestyle.NoteStyle;
import funkin.play.notes.notekind.NoteKindManager;
import funkin.play.notes.Strumline;
import funkin.play.notes.StrumlineNote;

class NoteSwapEvent extends ScriptedSongEvent
{
  var noteStyles:Map<String, String>;

  public override function handleEvent(data)
  {
    if (PlayState.instance?.currentStage == null || PlayState.instance.isMinimalMode) return;

    switch (data.value.strumline)
    {
      case 'playerStrumline':
        ModuleHandler.getModule('SwappingNotestyles').swapPlayerStrumlines(data.value.notestyle);
      case 'opponentStrumline':
        ModuleHandler.getModule('SwappingNotestyles').swapOpponentStrumlines(data.value.notestyle);
      case 'both':
        ModuleHandler.getModule('SwappingNotestyles').swapStrumlines(data.value.notestyle);
    }
  }

  public function getEventSchema()
  {
    if (noteStyles == null)
    {
      noteStyles = ["Funkin'" => "funkin", "Pixel" => "pixel"];
      var noteStyleIds:Array<String> = NoteStyleRegistry.instance.listEntryIds();

      for (noteStyleId in noteStyleIds)
      {
        var noteStyle:Null<NoteStyle> = NoteStyleRegistry.instance.fetchEntry(noteStyleId);
        if (noteStyle == null) continue;
        noteStyles.set(noteStyle.getName(), noteStyleId);
      }
    }
    return [{
      name: "strumline",
      title: "Strumline",
      defaultValue: "playerStrumline",
      type: "enum",
      keys: ["Player" => "playerStrumline", "Opponent" => "opponentStrumline", "Both" => "both"]
    }, {
      name: "notestyle",
      title: "Notestyle",
      defaultValue: "funkin",
      type: "enum",
      keys: noteStyles,
    }];
  }

  public function getTitle()
  {
    return "Set NoteStyle";
  }

  public function new()
  {
    super('NoteSwapEvent', {processOldEvents: true});
  }
}

class SwappingNotestyles extends Module
{
  function new()
  {
    super('SwappingNotestyles');
  }

  override function onSongLoaded(event)
  {
    super.onSongLoaded(event);
    var cachedStyles:Array<String> = [];
    hasTriggeredEvent = false;
    for (events in event.events)
    {
      if (events.eventKind == 'NoteSwapEvent')
      {
        if (NoteStyleRegistry.instance.fetchEntry(events.value.notestyle) == null) continue;
        if (!cachedStyles.contains(events.value.notestyle))
        {
          cachedStyles.push(events.value.notestyle);
          var notestyle = NoteStyleRegistry.instance.fetchEntry(events.value.notestyle);
          FunkinMemory.cacheNoteStyle(notestyle); // I love you Funkin Team
        }
      }
    }
  }

  public var hasTriggeredEvent:Bool = false; // Coders can force a reload

  public override function onSongEvent(scriptEvent:SongEventScriptEvent)
  {
    super.onSongEvent(scriptEvent);
    if (scriptEvent.eventData.eventKind == "NoteSwapEvent")
    {
      // Post Update so we can check after all the scripts have a chance to cancel
      FlxG.signals.postUpdate.addOnce(() ->
      {
        if (!scriptEvent.eventCanceled) hasTriggeredEvent = true;
      });
    }
  }

  public function swapPlayerStrumlines(stylePlayer:String)
  {
    newPopUps(stylePlayer);
    setupNotes(PlayState.instance.playerStrumline, stylePlayer);
  }

  public function swapOpponentStrumlines(styleOpponent:String)
  {
    setupNotes(PlayState.instance.opponentStrumline, styleOpponent);
  }

  public function swapStrumlines(style:String)
  {
    newPopUps(style);
    setupNotes(PlayState.instance.playerStrumline, style);
    setupNotes(PlayState.instance.opponentStrumline, style);
  }

  public function newPopUps(newComboStyle:String)
  {
    var noteStyleId:String = newComboStyle;
    var noteStyle:NoteStyle = NoteStyleRegistry.instance.fetchEntry(noteStyleId) ?? NoteStyleRegistry.instance.fetchDefault();
    // Initialize the judgements and combo meter.
    PlayState.instance.comboPopUps.noteStyle = noteStyle;
  }

  function setupNotes(strumline:Strumline, style:String)
  {
    var noteStyleId:String = style;
    var noteStyle:NoteStyle = NoteStyleRegistry.instance.fetchEntry(noteStyleId) ?? NoteStyleRegistry.instance.fetchDefault();
    strumline.noteStyle = noteStyle;
    // Clear all notesplashes and hold covers so the game can make new ones (Do this first so I can redo these with the notes)
    strumline.noteSplashes.clear();
    strumline.noteHoldCovers.clear();
    for (i in 0...Strumline.KEY_COUNT)
    {
      var strumNote = strumline.strumlineNotes.members[i];
      var child:StrumlineNote = new StrumlineNote(noteStyle, strumline.isPlayer, Strumline.DIRECTIONS[i]);
      child.x = strumline.getXPos(Strumline.DIRECTIONS[i]);
      child.x += Strumline.INITIAL_OFFSET;
      child.y = 0;
      noteStyle.applyStrumlineOffsets(child);
      strumNote.kill();
      strumline.strumlineNotes.replace(strumNote, child);
    }
    for (note in strumline.notes)
    {
      var noteKindStyle:NoteStyle = NoteKindManager.getNoteStyle(note.kind, strumline.noteStyle.id) ?? noteStyle;
      note.setupNoteGraphic(noteKindStyle);
      note.playNoteAnimation(note.noteData.getDirection());
      if (note.isHoldNote)
      {
        note.holdNoteSprite.noteStyleOffsets = noteStyle.getHoldNoteOffsets();
        note.holdNoteSprite.setupHoldNoteGraphic(noteStyle);
        note.holdNoteSprite.updateHitbox();

        // Recenter hold notes
        note.holdNoteSprite.x = strumline.x;
        note.holdNoteSprite.x += strumline.getXPos(Strumline.DIRECTIONS[note.noteData.getDirection() % Strumline.KEY_COUNT]);
        note.holdNoteSprite.x += Strumline.STRUMLINE_SIZE / 2;
        note.holdNoteSprite.x -= note.holdNoteSprite.width / 2;

        // Replay hold cover anim
        if (note.holdNoteSprite.hitNote && note.holdNoteSprite.sustainLength > 100)
        {
          strumline.playNoteHoldCover(note.holdNoteSprite);
        }
      }
      strumline.onNoteIncoming.dispatch(note); // Restarts just in case a note uses it
    }
    #if mobile
    if (Preferences.controlsScheme == 'Arrows' && !ControlsHandler.hasExternalInputDevice)
    {
      if (strumline == PlayState.instance.opponentStrumline) fixOpponentStrumline(strumline);
      else
        fixPlayerStrumline(strumline);
    }
    #end
  }

  function fixOpponentStrumline(opponentStrumline:Strumline)
  {
    final amplification:Float = (FlxG.width / FlxG.height) / (FlxG.initialWidth / FlxG.initialHeight);
    final playerStrumlineScale:Float = ((FlxG.height / FlxG.width) * 1.95) * amplification;
    final playerNoteSpacing:Float = ((FlxG.height / FlxG.width) * 2.8) * amplification;

    opponentStrumline.enterMiniMode(0.4 * amplification);
    /*
      opponentStrumline.y = Constants.STRUMLINE_Y_OFFSET * 0.3;
      opponentStrumline.x -= 30;
     */
  }

  function fixPlayerStrumline(playerStrumline:Strumline)
  {
    final amplification:Float = (FlxG.width / FlxG.height) / (FlxG.initialWidth / FlxG.initialHeight);
    final playerStrumlineScale:Float = ((FlxG.height / FlxG.width) * 1.95) * amplification;
    final playerNoteSpacing:Float = ((FlxG.height / FlxG.width) * 2.8) * amplification;

    playerStrumline.strumlineScale.set(playerStrumlineScale, playerStrumlineScale);
    playerStrumline.setNoteSpacing(playerNoteSpacing);
    for (strum in playerStrumline)
    {
      strum.width *= 2;
    }
    /*
      playerStrumline.x = (FlxG.width - playerStrumline.width) / 2 + Constants.STRUMLINE_X_OFFSET;
      playerStrumline.y = (FlxG.height - playerStrumline.height) * 0.95 - Constants.STRUMLINE_Y_OFFSET;
      if (playerStrumline?.noteStyle?.id != "pixel") {
        #if android playerStrumline.y += 10; #end
      } else {
        playerStrumline.y -= 10;
      }
     */
    for (direction in Strumline.DIRECTIONS)
    {
      PlayState.instance.hitbox.getFirstHintByDirection(direction).follow(playerStrumline.getByDirection(direction));
    }
  }

  override function onSongRetry(event)
  {
    super.onSongRetry(event);
    if (hasTriggeredEvent)
    {
      swapStrumlines(PlayState.instance.currentChart.noteStyle, true);
      hasTriggeredEvent = false;
    }
  }
}
